        },
        {
          "name": "인연 Lv.2",
          "ids": [
            "0_H100",
            "0_H101",
            "0_H102",
            "0_H103",
            "0_H104"
          ],
          "subtitle": "싸운 적? 없어. 마술? 그런 거 몰라. \n생전의 난 평범한 소녀였다니까? 정말이야",
          "text": [
