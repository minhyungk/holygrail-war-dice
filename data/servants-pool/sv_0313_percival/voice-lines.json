            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 25
        },
        {
          "name": "대화 12",
          "ids": [
            "0_H220",
            "0_H221"
          ],
          "subtitle": "트리스탄. 바람기는, 좋지 않아.",
          "text": [
            "",
            ""
