          "cond_type": "svtLimit",
          "cond_value": 1
        },
        {
          "name": "영기재림 2",
          "ids": [
            "0_G020",
            "0_G021"
          ],
          "subtitle": "껄껄껄…… 노익장이라는 거라네.",
