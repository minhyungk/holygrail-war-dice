        },
        {
          "name": "레벨 업",
          "ids": [
            "0_G8120",
            "0_G8121"
          ],
          "subtitle": "감사를 가슴에 품고, 고맙다는 뜻이 담긴 마임.",
          "text": [
            "감사를 가슴에 품고,",
            "고맙다는 뜻이 담긴 마임."
          ],
          "cond_type": "svtLevel",
