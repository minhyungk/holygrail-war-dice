        {
          "name": "미션에 대해 4",
          "ids": [
            "0_M040"
          ],
          "subtitle": "좋아. 그럼 다음 단계로 넘어가도록 하자.",
          "text": [
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "미션에 대해 5",
          "ids": [
            "0_M050"
          ],
          "subtitle": "다음은 교실이 바뀐다. 지각하지 않도록.",
