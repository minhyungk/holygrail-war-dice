    {
      "type": "boxGachaTalk",
      "voice_prefix": 0,
      "lines": [
        {
          "name": "박스 가챠 음성 1",
          "ids": [
            "0_C010",
            "0_C011",
            "0_C012"
          ],
          "subtitle": "아아, 시작되었군요. 그러면…… 원하는 물자를 받으실 수 있기를.",
          "text": [
            "아아, 시작되었군요.[r]\n그러면…… 원하는 물자를 받으실 수 있기를.",
            "",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 2",
          "ids": [
            "0_C020",
            "0_C021",
            "0_C022"
          ],
          "subtitle": "회전 개시! 이제는, 결과만이 기다리고 있습니다. \n하지만…… 기도할 수는 있겠지요.",
          "text": [
            "회전 개시![r]\n이제는, 결과만이 기다리고 있습니다.[r]\n하지만…… 기도할 수는 있겠지요.",
            "",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 3",
          "ids": [
            "0_C030",
            "0_C031",
            "0_C032"
          ],
          "subtitle": "스위치 온! 돕니다. 돕니다!",
          "text": [
            "스위치 온![r]\n돕니다.\n돕니다!",
            "",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 4",
          "ids": [
            "0_C040",
            "0_C041",
            "0_C042"
          ],
          "subtitle": "사과는─── 영양이 풍부합니다. 그리고…… 달죠. 저는 좋아한답니다.",
          "text": [
            "사과는───\n영양이 풍부합니다. 그리고…… 달죠.[r]\n저는 좋아한답니다.",
            "",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 5",
          "ids": [
            "0_C050",
            "0_C051"
          ],
          "subtitle": "중요물자가 도착한 모양입니다! 정말 운이 좋으시네요.",
          "text": [
            "중요물자가 도착한 모양입니다![r]\n정말 운이 좋으시네요.",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 6",
          "ids": [
            "0_C060",
            "0_C061"
          ],
          "subtitle": "아아, 최후의 중요물자로군요! ……시, 실례했습니다. \n조금, 흥분하고 말았습니다.",
          "text": [
            "아아, 최후의 중요물자로군요![r]\n……시, 실례했습니다. 조금, 흥분하고 말았습니다.",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 7",
          "ids": [
            "0_C110",
            "0_C111"
          ],
          "subtitle": "그러면, 물자를 수령해 주세요. 여기에 사인을.",
          "text": [
            "그러면, 물자를 수령해 주세요.[r]\n여기에 사인을.",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 8",
          "ids": [
            "0_C120",
            "0_C121"
          ],
          "subtitle": "흠흠, 그런 식으로……",
          "text": [
            "흠흠,[r]\n그런 식으로……",
            ""
          ],
          "cond_type": "eventEnd",
          "cond_value": 0
        },
        {
          "name": "박스 가챠 음성 9",
          "ids": [
            "0_C130"
