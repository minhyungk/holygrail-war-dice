            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 4
        },
        {
          "name": "인연 Lv.5",
          "ids": [
            "0_H130"
          ],
          "subtitle": "흠, 그럼 나도 널 만져야지. 이걸로 대등한 관계라는 거지!",
          "text": [
            ""
          ],
          "cond_type": "svtFriendship",
