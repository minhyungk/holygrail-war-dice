    {
      "type": "treasureDevice",
      "voice_prefix": 0,
      "lines": [
        {
          "name": "보구 {0}",
          "ids": [
            "0_B050",
            "0_B051",
            "0_B052"
          ],
          "subtitle": "이 한때에 모든 것을. 모든 것을 이 한때에. \n이것이야말로 리큐의 차이므로 부디 마음껏 즐겨주시기를. ──‘일기일회’",
          "text": [
            "^0:0:3.33:이 한때에 모든 것을.^0:3.34:E:모든 것을 이 한때에.^1:0:3.33:이 한때에 모든 것을.^1:3.34:E:모든 것을 이 한때에.",
            "이것이야말로 리큐의 차이므로 부디 마음껏 즐겨주시기를.",
            "──‘일기일회’"
          ],
          "cond_type": "flag",
          "cond_value": 1
        },
        {
          "name": "보구 {0}",
          "ids": [
            "0_B800",
            "0_B801",
            "0_B802"
          ],
          "subtitle": "검게, 검게, 검게, 검게, 더욱 검게──! \n모든 것을 반죽하고 불태워 검은 세상에 이르겠나이다.",
          "text": [
            "검게, 검게, 검게, 검게,",
            "더욱 검게──! 모든 것을 반죽하고 불태워",
            "검은 세상에 이르겠나이다."
          ],
          "cond_type": "flag",
          "cond_value": 7
        },
        {
          "name": "보구 {0}",
          "ids": [
            "0_B810",
            "0_B811"
          ],
          "subtitle": "다도란, 그저 끓이고, 그저 달이고, 그저 마실 뿐입니다. \n따라서 ‘일기일회’── 이지요.",
          "text": [
            "^0:0:1.89:다도란,^0:1.9:1.6:그저 끓이고,^0:3.51:1.6:그저 달이고,^0:5.31:E:그저 마실 뿐입니다.^1:0:1.89:다도란,^1:1.9:1.6:그저 끓이고,^1:3.51:1.6:그저 달이고,^1:5.31:E:그저 마실 뿐입니다.",
            "따라서 ‘일기일회’── 이지요."
          ],
          "cond_type": "flag",
          "cond_value": 8
        },
        {
          "name": "보구 {0}",
          "ids": [
            "0_B812",
            "0_B813",
            "0_B814"
          ],
          "subtitle": "",
          "text": [
            "따라서",
            "일기일회.",
            "‘일기일회’── 이지요."
          ],
