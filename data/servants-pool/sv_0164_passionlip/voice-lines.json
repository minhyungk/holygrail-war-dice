    {
      "type": "home",
      "voice_prefix": 11,
      "lines": [
        {
          "name": "인연 Lv.1",
          "ids": [
            "11_H090",
            "11_H091",
            "11_H092"
          ],
          "subtitle": "저기…… 저는 여러분보다 강하지만……\n싸우는 건 서투르니까 잘 대해주시면……\n아, 아뇨, 아무것도 아닙니다……",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 1
        },
        {
          "name": "인연 Lv.2",
          "ids": [
            "11_H100",
            "11_H101",
            "11_H102"
          ],
          "subtitle": "……신기합니다.\n당신은 저를 꾸짖거나 싸우게 하는데……\n그때마다 가슴이 따뜻해지는 것 같아요……",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 2
        },
        {
          "name": "인연 Lv.3",
          "ids": [
            "11_H110",
            "11_H111",
            "11_H112"
          ],
          "subtitle": "저, 저기, 마스터라고 불러도 되지요……?\n마스터. 저의, 마스터……\n여여, 역시 아직 부끄러워……!",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 3
        },
        {
          "name": "인연 Lv.4",
          "ids": [
            "11_H120",
            "11_H121",
            "11_H122",
            "11_H123"
          ],
          "subtitle": "예? 제가 즐거워 보이나요?\n……예. 간신히 좋아하는 것을 알았습니다.\n그게 뭐냐고요?\n어어…… 저기, 눈앞에…… 있다고 할까……",
          "text": [
            "",
            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 4
        },
        {
          "name": "인연 Lv.5",
          "ids": [
            "11_H130",
            "11_H131",
            "11_H132",
            "11_H133",
            "11_H134",
            "11_H135"
          ],
          "subtitle": "……전 여기에 오길 잘했어요.\n당신에게 소환되어서 다행이에요.\n아직 사랑이란 것은 모르지만,\n겨우 스스로가 조금 좋아졌습니다.\n당신 덕분입니다.\n언젠가 손을 잡고 같이 걸어주세요, 마스터.",
          "text": [
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 5
        },
        {
          "name": "대화 1",
          "ids": [
            "11_H030",
            "11_H031",
            "11_H032"
          ],
          "subtitle": "꽤나 긴 휴식이네요……\n하, 하지만, 다른 사람은 다른 사람이고,\n저는 계속 방에 있어도 좋다고 생각해요……!",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 12
        },
        {
          "name": "대화 2",
          "ids": [
            "11_H040",
            "11_H041"
          ],
          "subtitle": "서번트는 마스터를 따르는 법이니까……\n무섭지만, 거들어 드리겠습니다.",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 13
        },
        {
          "name": "대화 3",
          "ids": [
            "11_H050",
            "11_H051"
          ],
          "subtitle": "명령받는 건 싫지 않습니다……\n하지만 다들 금방 저를 괴롭히니까……",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 14
        },
        {
          "name": "좋아하는 것",
          "ids": [
            "11_H060",
            "11_H061",
            "11_H062"
          ],
          "subtitle": "좋아하는 것……\n저기, 특기, 를 말하면 될까요?\n물건을 부수는 거라면 맡겨주세요!",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 15
        },
        {
          "name": "싫어하는 것",
          "ids": [
            "11_H070",
            "11_H071",
            "11_H072"
          ],
          "subtitle": "싫어하는 건 별로 없어요.\n이전의 저는 무서운 것을 모두 싫은 것이라고 생각했지만, 지금은───\n저기, 무서워도 마음 착한 사람이 있다고 아니까요.",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 16
        },
        {
          "name": "성배에 대하여",
          "ids": [
            "11_H080",
            "11_H081"
          ],
          "subtitle": "성배 말인가요?……\n뭐든지 소원이 들어준다면, 인간이 되고 싶습니다……",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 17
        },
        {
          "name": "대화 4",
          "ids": [
            "11_H140",
            "11_H141"
          ],
          "subtitle": "어머님…… BB도 있군요.\n그 사람, 항상 화만 내서 거북합니다……",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 18
        },
        {
          "name": "대화 5",
          "ids": [
            "11_H150",
            "11_H151",
            "11_H152",
            "11_H153"
          ],
          "subtitle": "멜트는 언니 행세하지만, 사실은 저보다 어리다고 할까,\n어떻게 봐도 어린이 체형이라고 할까……\n아, 아뇨, 아무것도 아닙니다!\n멜트에게는 말하지 마세요!",
          "text": [
            "",
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 19
        },
        {
          "name": "대화 6",
          "ids": [
            "11_H160",
            "11_H161",
            "11_H162",
            "11_H163"
          ],
          "subtitle": "햐아아, 로빈 씨가 있어요오오오!\n안 돼, 그 사람은 안 돼요, 생리적으로!\n싫은 소리만 하고,\n툭하면 엉덩이를 때리고 들어요~~~!",
          "text": [
            "",
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 20
        },
        {
          "name": "대화 7",
          "ids": [
            "11_H170",
            "11_H171",
            "11_H172"
          ],
          "subtitle": "가, 가슴만 보지 말아주세요……!\n……우우.\n너무 못되게 굴면 가슴 속에 넣어버릴 거니까요……",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 21
        },
        {
          "name": "대화 7",
          "ids": [
            "11_H700",
            "11_H701",
            "11_H702"
          ],
          "subtitle": "가, 가슴만 보지 말아주세요~! 아니, 만져도 안 돼요!\n실수로라도 떨어지기라도 하면 큰일이거든요?!",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 21
        },
        {
          "name": "대화 9",
          "ids": [
            "11_H190",
            "11_H191",
            "11_H192",
            "11_H193"
          ],
          "subtitle": "카즈라드롭은 무섭지만, 저는 그렇게까지 싫지는 않아요……\n저는 사랑한 사람에 대한 증오에 사로잡혀 버렸지만, \n그 아이는 무슨 짓을 당해도 남을 사랑할 수 없으니까……",
          "text": [
            "",
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 23
        },
        {
          "name": "이벤트 개최중",
          "ids": [
            "11_H020",
            "11_H021",
            "11_H022"
          ],
          "subtitle": "……밖이 시끄러워……\n축제, 일까……\n싫은데…… 마스터랑 함께 있고 싶은데……",
          "text": [
            "",
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 11
        },
        {
          "name": "생일",
          "ids": [
            "11_H010",
            "11_H011",
            "11_H012"
          ],
          "subtitle": "생일, 축하합니다……\n저기, 하찮은 것이지만, 이것을……\n버서커의 공격에도 깨지지 않는 쿠키입니다……",
