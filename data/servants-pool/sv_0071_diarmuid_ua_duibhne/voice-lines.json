          "cond_type": "flag",
          "cond_value": 17
        },
        {
          "name": "인연 Lv.1",
          "ids": [
            "0_H090",
            "0_H091"
          ],
          "subtitle": "어라, 마스터. 무슨 일 있습니까?",
