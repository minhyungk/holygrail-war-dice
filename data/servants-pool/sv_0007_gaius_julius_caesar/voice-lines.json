          "cond_type": "flag",
          "cond_value": 24
        },
        {
          "name": "대화 11",
          "ids": [
            "0_H210",
            "0_H211"
          ],
          "subtitle": "오오, 우리의 신조, 건국왕 로물루스. 로마.",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
