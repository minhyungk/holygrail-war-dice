      "voice_prefix": 0,
      "lines": [
        {
          "name": "박스 가챠 음성 1",
          "ids": [
            "0_C010",
            "0_C011",
            "0_C012"
          ],
          "subtitle": "위잉위잉~ 규웅규웅~ 꽝~꽈광~ 에? 돌린다면 이런 거 아닌가요?",
          "text": [
            "위잉위잉~ 규웅규웅~[r]\n꽝~꽈광~\n에? 돌린다면 이런 거 아닌가요?",
            "",
