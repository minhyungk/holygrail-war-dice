  "groups": [
    {
      "type": "home",
      "voice_prefix": 0,
      "lines": [
        {
          "name": "생일",
          "ids": [
            "0_H010"
          ],
          "subtitle": "오, 네가 태어난 날 아닌가.\n자, 하늘을 향해 감사해.",
          "text": [
            ""
          ],
          "cond_type": "birthDay",
          "cond_value": 0
        },
        {
          "name": "이벤트 개최중",
          "ids": [
            "0_H020"
          ],
          "subtitle": "구린데…… 뭔가 있겠지.\n가볼까.",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 11
        },
        {
          "name": "대화 1",
          "ids": [
            "0_H030"
          ],
          "subtitle": "어이어이, 마스터,\n틀어박혀 있는다고 뭐가 돼? 응?",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 12
        },
        {
          "name": "대화 2",
          "ids": [
            "0_H040"
          ],
          "subtitle": "안심하라고. 버서커라도 서번트.\n네 몸은 내가 지켜주지.",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 13
        },
        {
          "name": "대화 3",
          "ids": [
            "0_H050"
          ],
          "subtitle": "못된 짓을 할 때는 눈을 돌려주지.\n물론 한도란 게 있지만.",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 14
        },
        {
          "name": "좋아하는 것",
          "ids": [
            "0_H060",
            "0_H061"
          ],
          "subtitle": "지금 깨달은 건데 난 취미가 없군.\n쌈박질이 좋은 걸로는 안 되나?\n안 되는군.",
          "text": [
            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 15
        },
        {
          "name": "싫어하는 것",
          "ids": [
            "0_H070"
          ],
          "subtitle": "용은 싫어. 하지만 먹으면 맛있지.",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 16
        },
        {
          "name": "성배에 대하여",
          "ids": [
            "0_H080"
          ],
          "subtitle": "성배라. 뭐, 탐난다면 그것도 좋겠지.\n나는 필요없지만.",
          "text": [
            ""
          ],
          "cond_type": "flag",
          "cond_value": 17
        },
        {
          "name": "인연 Lv.1",
          "ids": [
            "0_H090"
          ],
          "subtitle": "……응?",
          "text": [
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 1
        },
        {
          "name": "인연 Lv.2",
          "ids": [
            "0_H100"
          ],
          "subtitle": "미안, 미안, 아무 짓도 안 해.",
          "text": [
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 2
        },
        {
          "name": "인연 Lv.3",
          "ids": [
            "0_H110"
          ],
          "subtitle": "참 나, 무슨 일이야? 다루기 어려운데.",
          "text": [
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 3
        },
        {
          "name": "인연 Lv.4",
          "ids": [
            "0_H120"
          ],
          "subtitle": "어쩔 수 없군. 큰 마음 먹고 어울려줘 볼까.\n그래서 뭘 바라는데?",
          "text": [
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 4
        },
        {
          "name": "인연 Lv.5",
          "ids": [
            "0_H130",
            "0_H131"
          ],
          "subtitle": "좋잖아. 마음에 들었어.\n앞으로도 마음에 안 드는 놈들은 패고, 패고,\n또 패버리는 거야!",
          "text": [
            "",
            ""
          ],
          "cond_type": "svtFriendship",
          "cond_value": 5
        }
      ]
    },
    {
