            "",
            ""
          ],
          "cond_type": "flag",
          "cond_value": 21
        },
        {
          "name": "대화 8",
          "ids": [
            "0_H180",
            "0_H181"
          ],
          "subtitle": "라이코 님! 그 모습은, 아와와…….",
