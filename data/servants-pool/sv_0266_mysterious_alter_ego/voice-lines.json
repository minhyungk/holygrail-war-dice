          "cond_type": "flag",
          "cond_value": 13
        },
        {
          "name": "대화 3",
          "ids": [
            "0_H050",
            "0_H051"
          ],
          "subtitle": "사인도 악수도 사양이야. 눈치 좀 채.",
          "text": [
