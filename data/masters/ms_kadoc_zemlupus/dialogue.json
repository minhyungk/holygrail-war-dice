    "master_seal_use": [
      {
        "id": "buff",
        "text": "영주로 명령한다. ……어쩔 수 없잖아, 이기려면.",
        "tone": "cold",
        "when": {
          "event.purpose": "buff"
        }
      },
      {
        "id": "escape",
        "text": "빠진다. 이런 데서 목숨 거는 건 바보나 하는 짓이야.",
        "tone": "cold",
        "when": {
          "event.purpose": "escape"
