{
  "scope": "common",
  "speaker": "narrator",
  "defaults": {
    "status": "draft",
    "author": "ai",
    "weight": 1,
    "repeat": "always",
    "source": "new"
  },
  "notes": "공통 나레이션 임시 초안. 태그는 이벤트 이름 기반 임시 ID (Q-50). 시점은 3인칭 관찰자 (D-069). 이름은 자리표시자로만 쓴다 (정보 가림).",
  "tags": {
    "phase_defended": [
      {
        "id": "defended_01",
        "slot": "react",
        "text": "전설이 쏟아진다. ──그러나 {target}{은/는} 쓰러지지 않았다. 버텨 냈다. 그것만으로, 이 국면은 끝났다.",
        "notes": "일방 보구를 막아 냄 (D-120)"
      },
      {
        "id": "defended_02",
        "slot": "react",
        "text": "빛이 걷힌 자리에, {target}{이/가} 서 있다. 피한 것인지, 견딘 것인지──어느 쪽이든, 일격은 닿지 않았다."
      },
      {
        "id": "defended_03",
        "slot": "react",
        "text": "{actor}의 보구가 허공을 가른다. 한 발, 아주 한 발. {target}{은/는} 이미 그 궤적 밖에 있었다."
      },
      {
        "id": "defended_np_clash",
        "slot": "tail",
        "text": "막아 냈다. 그러나 마력의 잔향이, 아직 공기를 태우고 있다."
      }
    ],
    "affinity_change": [
      {
        "id": "up_small_1",
        "slot": "tail",
        "text": "{servant}의 표정이 아주 조금 누그러진 듯하다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "small"
        },
        "notes": "호감도 변화 시스템 문구 (D-121)"
      },
      {
        "id": "up_small_2",
        "slot": "tail",
        "text": "{servant}{이/가} 약간 우호적으로 변한 듯하다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "small"
        }
      },
      {
        "id": "up_small_3",
        "slot": "tail",
        "text": "{servant}의 말투에서 가시가 하나 빠진 것 같다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "small"
        }
      },
      {
        "id": "up_mid_1",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터를 조금 더 믿게 된 것 같다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "up_mid_2",
        "slot": "tail",
        "text": "{servant}{와/과}의 거리가 한 걸음 가까워졌다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "up_mid_3",
        "slot": "tail",
        "text": "{servant}의 시선이 전보다 부드럽다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "up_big_1",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터를 확실히 다시 보게 된 듯하다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "big"
        }
      },
      {
        "id": "up_big_2",
        "slot": "tail",
        "text": "{servant}{와/과}의 사이에, 분명한 신뢰가 싹텄다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "big"
        }
      },
      {
        "id": "up_big_3",
        "slot": "tail",
        "text": "{servant}{이/가} 처음으로, 진심으로 웃은 것 같다.",
        "when": {
          "event.direction": "up",
          "event.magnitude": "big"
        }
      },
      {
        "id": "down_small_1",
        "slot": "tail",
        "text": "{servant}{이/가} 약간 언짢아 보인다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "small"
        }
      },
      {
        "id": "down_small_2",
        "slot": "tail",
        "text": "{servant}의 대답이 조금 짧아졌다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "small"
        }
      },
      {
        "id": "down_small_3",
        "slot": "tail",
        "text": "{servant}{이/가} 작게 한숨을 쉰 것 같다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "small"
        }
      },
      {
        "id": "down_mid_1",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터에게 실망한 듯하다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "down_mid_2",
        "slot": "tail",
        "text": "{servant}{와/과}의 사이에 서늘한 공기가 흐른다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "down_mid_3",
        "slot": "tail",
        "text": "{servant}{이/가} 눈을 마주치려 하지 않는다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "mid"
        }
      },
      {
        "id": "down_big_1",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터를 차갑게 쳐다본다. 무언가가 크게 어긋났다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "big"
        }
      },
      {
        "id": "down_big_2",
        "slot": "tail",
        "text": "{servant}의 신뢰가 눈에 띄게 식었다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "big"
        }
      },
      {
        "id": "down_big_3",
        "slot": "tail",
        "text": "계약의 선 너머로, {servant}의 분노가 전해져 온다.",
        "when": {
          "event.direction": "down",
          "event.magnitude": "big"
        }
      },
      {
        "id": "tier_up_wary",
        "slot": "tail",
        "text": "{servant}의 적의가 한풀 꺾였다.",
        "when": {
          "event.direction": "up",
          "event.tier_changed": true,
          "event.tier_to": "wary"
        }
      },
      {
        "id": "tier_up_neutral",
        "slot": "tail",
        "text": "{servant}의 경계심이 조금 풀렸다.",
        "when": {
          "event.direction": "up",
          "event.tier_changed": true,
          "event.tier_to": "neutral"
        }
      },
      {
        "id": "tier_up_friendly",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터를 동료로 인정하기 시작했다.",
        "when": {
          "event.direction": "up",
          "event.tier_changed": true,
          "event.tier_to": "friendly"
        }
      },
      {
        "id": "tier_up_loyal",
        "slot": "tail",
        "text": "{servant}{은/는} 이제 마스터를 위해서라면 무엇이든 할 것 같다.",
        "when": {
          "event.direction": "up",
          "event.tier_changed": true,
          "event.tier_to": "loyal"
        }
      },
      {
        "id": "tier_down_friendly",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터에게 품었던 깊은 신뢰가 흔들린다.",
        "when": {
          "event.direction": "down",
          "event.tier_changed": true,
          "event.tier_to": "friendly"
        }
      },
      {
        "id": "tier_down_neutral",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터와 한 발 거리를 두기 시작했다.",
        "when": {
          "event.direction": "down",
          "event.tier_changed": true,
          "event.tier_to": "neutral"
        }
      },
      {
        "id": "tier_down_wary",
        "slot": "tail",
        "text": "{servant}{이/가} 마스터를 경계하기 시작했다. 명령을 따르지 않을지도 모른다.",
        "when": {
          "event.direction": "down",
          "event.tier_changed": true,
          "event.tier_to": "wary"
        }
      },
      {
        "id": "tier_down_hostile",
        "slot": "tail",
        "text": "{servant}의 눈에 적의가 서렸다. ──배신의 기척이 느껴진다.",
        "when": {
          "event.direction": "down",
          "event.tier_changed": true,
          "event.tier_to": "hostile"
        }
      },
      {
        "id": "release_up",
        "slot": "tail",
        "text": "자비를 택한 마스터를 보고, {servant}{이/가} 작게 고개를 끄덕였다.",
        "when": {
          "event.direction": "up",
          "event.cause": "release"
        }
      },
      {
        "id": "release_down",
        "slot": "tail",
        "text": "{servant}{은/는} 적을 살려 보낸 결정이 못마땅한 듯하다.",
        "when": {
          "event.direction": "down",
          "event.cause": "release"
        }
      },
      {
        "id": "execute_up",
        "slot": "tail",
        "text": "{servant}{은/는} 망설임 없는 결단을 마음에 들어 하는 것 같다.",
        "when": {
          "event.direction": "up",
          "event.cause": "execute"
        }
      },
      {
        "id": "execute_down",
        "slot": "tail",
        "text": "{servant}{이/가} 처치를 명한 마스터를 말없이 바라본다.",
        "when": {
          "event.direction": "down",
          "event.cause": "execute"
        }
      },
      {
        "id": "supply_up",
        "slot": "tail",
        "text": "마력과 함께, 무언가 따뜻한 것이 전해진 것 같다.",
        "when": {
          "event.direction": "up",
          "event.cause": "supply"
        }
      },
      {
        "id": "supply_down",
        "slot": "tail",
        "text": "{servant}{이/가} 어색하게 시선을 피한다.",
        "when": {
          "event.direction": "down",
          "event.cause": "supply"
        }
      },
      {
        "id": "bond_up",
        "slot": "tail",
        "text": "함께 보낸 시간이, {servant}의 마음을 조금 열었다.",
        "when": {
          "event.direction": "up",
          "event.cause": "bond"
        }
      },
      {
        "id": "bond_down",
        "slot": "tail",
        "text": "{servant}{은/는} 오늘의 동행이 즐겁지 않았던 모양이다.",
        "when": {
          "event.direction": "down",
          "event.cause": "bond"
        }
      }
    ],
    "day_started": [
      {
        "id": "base",
        "slot": "lead",
        "text": "아침. 후유키의 하늘은, 어젯밤의 일 따위 모른다는 듯 맑았다."
      },
      {
        "id": "day1",
        "slot": "lead",
        "text": "성배전쟁, 첫째 날. ──아직 아무것도 시작되지 않은 척, 도시는 평소처럼 숨을 쉰다.",
        "when": {
          "world.day": 1
        },
        "repeat": "once_per_run"
      },
      {
        "id": "day7",
        "slot": "lead",
        "text": "일곱째 날. 남은 것은 오늘 하루, 그리고 오늘 밤.",
        "when": {
          "world.day": 7
        },
        "repeat": "once_per_run"
      },
      {
        "id": "rumor_vague",
        "slot": "lead",
        "text": "밤사이 도시 어딘가에서, 거대한 마력이 충돌했다고 한다. 누가 누구와──그것까지는 알 수 없다.",
        "when": {
          "event.rumor": true,
          "event.rumor_known": false
        },
        "notes": "소문 (§8.7). 정보 부족"
      },
      {
        "id": "rumor_known",
        "slot": "lead",
        "text": "{loser}의 기척이 끊겼다. 밤사이, 또 하나의 진영이 무너졌다.",
        "when": {
          "event.rumor": true,
          "event.rumor_known": true
        },
        "notes": "소문 (§8.7)"
      }
    ],
    "night_started": [
      {
        "id": "base_01",
        "slot": "lead",
        "text": "해가 진다. 사람의 시간이 끝나고, 영령의 시간이 시작된다."
      },
      {
        "id": "base_02",
        "slot": "lead",
        "text": "밤. 거리에서 인기척이 사라진다. 남은 것은, 공기에 밴 마력의 잔향뿐."
      },
      {
        "id": "hurt",
        "slot": "lead",
        "text": "상처가 채 아물지 않은 채로, 또 밤이 온다.",
        "when": {
          "self.condition": "hurt"
        }
      }
    ],
    "day_bond": [
      {
        "id": "urban",
        "slot": "lead",
        "text": "낮의 거리는 평화롭다. 이곳이 전쟁터라는 사실을, 잠시 잊을 수 있을 만큼.",
        "when": {
          "world.terrain": "urban"
        }
      },
      {
        "id": "river",
        "slot": "lead",
        "text": "햇빛이 수면 위에서 부서진다. 바람이, 강을 따라 천천히 흐른다.",
        "when": {
          "world.terrain": "river"
        }
      },
      {
        "id": "open",
        "slot": "lead",
        "text": "구름 그림자가 들판을 느릿하게 가로지른다.",
        "when": {
          "world.terrain": "open"
        }
      },
      {
        "id": "forest",
        "slot": "lead",
        "text": "나뭇잎 사이로 빛이 스민다. 새소리가, 멀리서 들려온다.",
        "when": {
          "world.terrain": "forest"
        }
      },
      {
        "id": "react_tender",
        "slot": "react",
        "text": "그 목소리는, 전장에서 듣던 것과는 조금 달랐다.",
        "when": {
          "beat.line.tone": "tender"
        }
      },
      {
        "id": "react_cold",
        "slot": "react",
        "text": "대답은 짧았다. 둘 사이의 거리는, 걸음 수만큼 좁혀지지 않는다.",
        "when": {
          "beat.line.tone": "cold"
        }
      }
    ],
    "intel": [
      {
        "id": "base",
        "slot": "lead",
        "text": "도시에 흩어진 흔적을 좇는다. 마력의 잔향, 부자연스러운 결계, 사람들의 소문."
      }
    ],
    "battle_start": [
      {
        "id": "place_open",
        "slot": "lead",
        "text": "탁 트인 공터. 숨을 곳도, 물러설 곳도 없다.",
        "when": {
          "world.terrain": "open",
          "scene.setting_told": false
        }
      },
      {
        "id": "place_urban",
        "slot": "lead",
        "text": "잠든 주택가. 가로등 불빛 아래로, 두 개의 그림자가 길게 늘어진다.",
        "when": {
          "world.terrain": "urban",
          "scene.setting_told": false
        }
      },
      {
        "id": "place_forest",
        "slot": "lead",
        "text": "나무 사이로 달빛이 조각나 떨어진다. 어둠이, 칼날의 윤곽을 삼킨다.",
        "when": {
          "world.terrain": "forest",
          "scene.setting_told": false
        }
      },
      {
        "id": "place_river",
        "slot": "lead",
        "text": "강물 소리가 모든 기척을 덮는다. ──그러나 살기만은, 덮이지 않았다.",
        "when": {
          "world.terrain": "river",
          "scene.setting_told": false
        }
      },
      {
        "id": "enemy_unknown",
        "slot": "lead",
        "text": "어둠 속에서 누군가 걸어 나온다. 정체를 알 수 없는──그러나 틀림없는, 서번트.",
        "when": {
          "enemy.intel_level": 0
        }
      },
      {
        "id": "enemy_class",
        "slot": "lead",
        "text": "{enemy}. 드러난 것은 클래스뿐. 그 이상은, 칼끝이 밝혀낼 것이다.",
        "when": {
          "enemy.intel_level": {
            "in": [
              1,
              2
            ]
          }
        }
      },
      {
        "id": "enemy_named",
        "slot": "lead",
        "text": "{enemy}. 이름도 전설도 이미 드러난 상대. ──그렇기에 더욱, 방심은 허락되지 않는다.",
        "when": {
          "enemy.intel_level": 3
        }
      },
      {
        "id": "enemy_released",
        "slot": "lead",
        "text": "한 번 등을 보이고 떠났던 그림자가, 다시 앞을 막아선다.",
        "when": {
          "mem.released": true
        },
        "repeat": "once_per_run"
      },
      {
        "id": "react_defiant",
        "slot": "react",
        "text": "허세가 아니다. 그 목소리에는, 이미 승부를 정한 자의 무게가 실려 있었다.",
        "when": {
          "beat.line.tone": "defiant"
        }
      },
      {
        "id": "react_playful",
        "slot": "react",
        "text": "가벼운 말투와 달리, 그 눈은 조금도 웃고 있지 않았다.",
        "when": {
          "beat.line.tone": "playful"
        }
      },
      {
        "id": "react_roar",
        "slot": "react",
        "text": "말이 아닌 포효. 그것만으로 대기가 떨리고, 세계의 질감이 삐걱거린다.",
        "when": {
          "beat.line.tone": "roar"
        }
      },
      {
        "id": "tail",
        "slot": "tail",
        "text": "대화는 거기까지였다. ──공기가, 팽팽하게 당겨진다."
      }
    ],
    "phase_start": [
      {
        "id": "clash",
        "slot": "lead",
        "text": "정면. 피할 생각도, 피할 틈도 없다.",
        "when": {
          "event.phase_id": "ph_clash"
        }
      },
      {
        "id": "initiative",
        "slot": "lead",
        "text": "먼저 움직이는 쪽이 이긴다. ──찰나를 다투는 싸움.",
        "when": {
          "event.phase_id": "ph_initiative"
        }
      },
      {
        "id": "sorcery",
        "slot": "lead",
        "text": "마력이 소용돌이친다. 회로가 타는 냄새가, 밤공기에 섞인다.",
        "when": {
          "event.phase_id": "ph_sorcery"
        }
      },
      {
        "id": "fate",
        "slot": "lead",
        "text": "승패를 가르는 것은 힘도 기술도 아니다. 운명이라는 이름의, 한 번의 주사위.",
        "when": {
          "event.phase_id": "ph_fate"
        }
      },
      {
        "id": "np_clash",
        "slot": "lead",
        "text": "두 개의 전설이, 지금 정면으로 부딪친다.",
        "when": {
          "event.phase_id": "ph_np_clash"
        }
      },
      {
