{
  "notes": "이벤트 → 비트 템플릿 (narrative-engine.md §8.2, D-104). 태그는 임시 태그 (D-105). from: narrator / self(플레이어 서번트) / enemy(상대 서번트) / actor(이벤트 주체 서번트) / enemy_master(상대 마스터). tag_by: 사실 값에 따라 태그를 고른다. if: 이 슬롯을 쓸 조건(사실). when_has / when_lacks: 후보 대사의 when에 그 사실이 있는/없는 것만. protected: 템포 상한에 잘리지 않음 (Q-156 ②). size: big / normal / small / auto(국면 결과). style: system이면 화면에서 시스템 문구 모양으로 보인다 (호감도 변화 등). chance: text.slot_chance의 이름. 그 확률로만 슬롯을 쓴다 (D-151). affinity_reaction: 선택 반응 호감도 변화(cause react:*)용 템플릿 (D-150).",
  "beats": {
    "day_started": {
      "size": "small",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "day_started"
        }
      ]
    },
    "night_started": {
      "size": "small",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "night_started"
        }
      ]
    },
    "action_started": {
      "size": "small",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag_by": {
            "fact": "event.action",
            "map": {
              "bond": "day_bond",
              "intel": "intel",
              "supply": "mana_supply"
            }
          }
        }
      ]
    },
    "bond": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "self",
          "tag_by": {
            "fact": "event.result",
            "map": {
              "success": "day_bond",
              "fail": "day_bond_fail"
            }
          }
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag_by": {
            "fact": "event.result",
            "map": {
              "success": "day_bond",
              "fail": "day_bond_fail"
            }
          }
        }
      ]
    },
    "intel_gained": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "self",
          "tag": "intel",
          "if": {
            "event.cause": "intel"
          }
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "intel_battle",
          "if": {
            "event.cause": "battle"
          }
        }
      ]
    },
    "encounter": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "enemy_master",
          "tag": "master_encounter"
        }
      ]
    },
    "battle_started": {
      "size": "big",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "battle_start",
          "when_has": "world.terrain"
        },
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "battle_start",
          "when_lacks": "world.terrain"
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "battle_start"
        },
        {
          "slot": "answer",
          "from": "enemy",
          "tag": "battle_start"
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "battle_start"
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "battle_start"
        }
      ]
    },
    "phase_started": {
      "size": "small",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "phase_start"
        }
      ]
    },
    "np_opened": {
      "size": "big",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "np_open"
        },
        {
          "slot": "line",
          "from": "actor",
          "tag": "np_open"
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "np_open",
          "protected": true
        }
      ]
    },
    "phase_resolved": {
      "size": "auto",
      "slots": [
        {
          "slot": "react",
          "from": "narrator",
          "tag": "miracle",
          "if": {
            "event.miracle": true
          },
          "protected": true
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "phase_defended",
          "if": {
            "event.result": "defended"
          }
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "phase_result",
          "if": {
            "event.result": {
              "not": "defended"
            }
          }
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "phase_win",
          "if": {
            "event.self_won": true
          },
          "chance": "self_phase_win"
        },
        {
          "slot": "answer",
          "from": "enemy",
          "tag": "phase_win",
          "if": { "event.self_lost": true },
          "chance": "enemy_phase_win"
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "phase_hit",
          "if": {
            "event.self_lost": true,
            "event.condition_to": "hurt"
          },
          "chance": "self_phase_hit"
        },
        {
          "slot": "answer",
          "from": "enemy",
          "tag": "phase_hit",
          "if": { "event.self_won": true, "event.condition_to": { "in": ["hurt", "danger"] } },
          "chance": "enemy_phase_hit"
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "phase_defended",
          "if": {
            "event.result": "defended"
          }
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "phase_result",
          "if": {
            "event.result": {
              "not": "defended"
            }
          }
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "crisis",
          "if": {
            "self.condition": "danger",
            "event.self_lost": true
          }
        },
        {
          "slot": "answer",
          "from": "enemy_master",
          "tag": "master_battle"
        }
      ]
    },
    "seal_used": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "actor",
          "tag": "seal_use",
          "if": {
            "beat.actor_side": "self"
          }
        },
        {
          "slot": "line",
          "from": "enemy_master",
          "tag": "master_seal_use",
          "if": {
            "beat.actor_side": "enemy"
          }
        }
      ]
    },
    "battle_ended": {
      "size": "big",
      "slots": [
        {
          "slot": "react",
          "from": "narrator",
          "tag": "comeback",
          "if": {
            "event.comeback": true
          },
          "protected": true
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "battle_end"
        },
        {
          "slot": "line",
          "from": "self",
          "tag_by": {
            "fact": "event.self_result",
            "map": {
              "win": "victory",
              "loss": "defeat",
              "draw": "draw"
            }
          },
          "if": {
            "event.comeback": false
          }
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "comeback",
          "if": {
            "event.comeback": true
          }
        }
      ]
    },
    "post_choice": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "self",
          "tag_by": {
            "fact": "event.choice",
            "map": {
              "execute": "execute",
              "release": "release"
            }
          }
        },
        {
          "slot": "answer",
          "from": "enemy_master",
          "tag_by": {
            "fact": "event.choice",
            "map": {
              "execute": "master_executed",
              "release": "master_eliminated"
            }
          }
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "post_choice"
        }
      ]
    },
    "affinity_changed": {
      "size": "small",
      "style": "system",
      "slots": [
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "affinity_change"
        }
      ]
    },
    "mana_supplied": {
      "size": "normal",
      "slots": [
        {
          "slot": "line",
          "from": "self",
          "tag": "mana_supply"
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "mana_supply"
        }
      ]
    },
    "npc_battle_resolved": {
      "size": "small",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "distant_battle"
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "distant_battle",
          "if": {
            "event.result": {
              "in": [
                "win",
                "escape",
                "draw"
              ]
            }
          }
        }
      ]
    },
    "final_started": {
      "size": "normal",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "final_start"
        },
        {
          "slot": "react",
          "from": "narrator",
          "tag": "final_start"
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "final_start"
        }
      ]
    },
    "weakness_used": {
      "size": "normal",
      "slots": [
        {
          "slot": "lead",
          "from": "narrator",
          "tag": "weakness",
          "protected": true
        },
        {
          "slot": "line",
          "from": "self",
          "tag": "weakness"
        }
      ]
    },
    "affinity_reaction": {
      "size": "small",
      "slots": [
        {
          "slot": "line",
          "from": "self",
          "tag": "react_choice",
          "if": {
            "event.reaction": {
              "in": [
                "encounter_fight",
                "encounter_flee",
                "danger_fight",
                "danger_run",
                "weakness"
              ]
            }
          }
        },
        {
          "slot": "tail",
          "from": "narrator",
          "tag": "affinity_change"
        }
      ]
    },
    "skill_triggered": {
      "size": "normal",
      "slots": [
        {
          "slot": "react",
          "from": "narrator",
          "tag": "skill_effect",
          "if": { "event.first": true },
          "protected": true
        },
        {
          "slot": "line",
          "from": "actor",
          "tag": "skill",
          "if": { "event.first": true },
          "chance": "battle_skill"
        }
      ]
    }
  }
}
