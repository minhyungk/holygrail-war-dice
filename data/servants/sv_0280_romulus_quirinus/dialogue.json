        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "인간의 광채, 낭만인 로마의 그것.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
