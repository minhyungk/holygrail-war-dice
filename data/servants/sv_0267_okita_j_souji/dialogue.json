        "text": "흥흐흐흥~응♪",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "오키타 씨 절호조!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
