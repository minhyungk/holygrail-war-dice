        "quote_verified": true
      },
      {
        "id": "fgo_ex_4",
        "text": "멀리서 실례?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_5",
