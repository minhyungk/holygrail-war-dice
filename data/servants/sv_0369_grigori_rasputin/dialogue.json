      },
      {
        "id": "fgo_atk_6",
        "text": "타격!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_7",
        "text": "훗…… 이미 늦었다네?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
