        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "이거랑 이거랑 이거랑 이거랑 이거랑 이거랑 이거, 전부!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
