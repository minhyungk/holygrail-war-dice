      {
        "id": "fgo_skill_1",
        "text": "아치독센, 해방……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "엘리멘탈, 기동……",
