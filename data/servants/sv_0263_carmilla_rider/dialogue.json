    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "대가를 치를 때…… 일까……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "아직…… 손에 넣지 못했는데……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "어머, 이런 우연도 다 있네. ……평소와 분위기가 달라? 후후, 그런가? 어찌 되었든, 내가 위험한 여자인 것은 변함없다고 생각해. 최대한 조심하도록 해, 마스터.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
