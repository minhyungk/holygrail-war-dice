    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "스카사하에게서 배운 룬 마술, 그 진수라는 것을──",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
