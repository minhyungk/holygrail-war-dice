            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이거야 원, 아직 영감이 오려면 멀었나.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
