        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "여름은 만남의 계절이라 합니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "그리고 사건은 시작되는 것이었습니다……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
