{
  "speaker": "sv_0043_charles_henri_sanson",
  "defaults": {
    "status": "draft",
    "author": "ai",
    "weight": 1,
    "repeat": "always",
    "source": "fgo"
  },
  "notes": "D-157 자동 편입. 대사는 Atlas KR 보이스(scripts/fetch-voices.mjs)만 들어 있고, 없는 상황은 클래스·공통 대사층이 맡는다 (D-143).",
  "tags": {
    "phase_win": [
      {
        "id": "fgo_atk_1",
        "text": "조용히.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_2",
        "text": "하앗!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_3",
        "text": "에잇!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_4",
        "text": "떨어져라!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "죄를 저울에 달겠다──!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "물러나라!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "집행 시간이다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "미안하지만 봐주지는 않아!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_3",
        "text": "미안하다고는 생각하지만……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "아뿔싸……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "큭!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_3",
        "text": "이것이, 벌인가……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_4",
        "text": "아직이야……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "각오는 되었는가?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "움직이지 마라, 조준이 빗나간다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "자, 진정해.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "어떻게 해야 할까.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "마스터, 어떻게 하시겠습니까?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "목을 쳐서, 피에 물든 손. 그런 것을 만져서 뭐가 된다고?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "죄인의 목숨과 죄를 나눈다. 그것이 자신의 역할이라고 맹세해온 인생입니다만…… 무섭군요. 당신의 눈은 제 망설임을 끄집어내는 듯합니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "성스러운 맹세에 걸고. 당신의 목은 제가 지키도록 하죠.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "당신의 칼날은 티끌 한 점 없이 옳습니다. 지옥의 끝까지, 하늘의 끝까지 함께하겠습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "평화, 행복, 자애, 이런 것을 싫어하는 분이 있을까요?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것 말입니까…… 누명을 용서할 수 없습니다.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배…… 소원은 있기야 있는데 크게 떠벌릴만한 정도는 아닙니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "힘을 빼고 목숨을 맡겨다오. 고통은 주지 않겠다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "사람을 죽이는 것이 아니라, 그 죄에서 해방시키는 것이다──",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "속죄의 전투, 혹은 벌하기 위한 싸움인가.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "이곳에 내가 있는 의미를 알아야만 해.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "이 아픔이, 최후의 구원이 될 것이다── ‘죽음은 내일을 향한 희망일지니!(라 모흐 에스푸아르)’",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "벌은 악이 아니며, 속죄도 악이 아니다── ‘죽음은 내일을 향한 희망일지니!(라 모흐 에스푸아르)’",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "악을 심판하는 건 인간의 마음. 무시무시한 무기를 사용한다고 해도…… 그것은 변함없어──!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "어떤가. 기분 좋은 잠에 들었으려나.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "주여. 죄 많은 우리를 용서해주소서.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "내가 승리한 게 아니야. 네가 잘못되어 있었던 거지.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "승리했습니다, 마스터. 생전에는 경험한 적이 없었습니다만…… 승리란 꽤 기분 좋은 것이로군요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "──당연한 일이군. 이것이야말로 인과라는 것이다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "미안합니다, 저는 여기까지입니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "구원을 바랄 생각은 없다…… 다만…… 잠시 눈을 감겠어.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "서번트, 어쌔신. 샤를=앙리 상송. 소환에 응해 찾아왔습니다.",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
}
