        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "무참하게 가혹하게 잔혹하게!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
