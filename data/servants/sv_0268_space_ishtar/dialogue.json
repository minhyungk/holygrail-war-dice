        "quote_verified": true
      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "보구……?! ……나 참, 뭘 하고 있었던 거야……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "칫……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
