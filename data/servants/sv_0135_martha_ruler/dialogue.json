    "phase_hit": [
      {
        "id": "fgo_dmg_2",
        "text": "크윽!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_1",
        "text": "아프───잖아!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "이렇게 하지 않으면 모르는가 보네?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "흥이 돋기 시작했어!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_like",
        "text": "아아, 저는 이것을 스스로 다스렸을 텐데…… 주님, 제게 싸우라고 말씀하시는군요.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것은, 미워하는 것은 있을 리 없을 텐데…… 주님, 저를 용서해주세요. 서번트로서 존재하는 저는 이렇게나 죄가 깊습니다……",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "그러니까 거짓 성배에 흥미 같은 건 없다니까! 알겠어? 진짜 성배는 단 하나야!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이건 뭔가 잘못된 것입니다. 분명 엑스트라 클래스로 현계했기 때문에 저는 거칠게 행동하는 것이지요. 트, 특히나…… 전투중의 그건…… 못 본 걸로 해.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "저는 결코 폭력을 긍정하지 않습니다. 아무리 거칠게 행동하더라도, 사실은, 이렇게는…… 아아, 주먹싸움을 즐기다니……!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "──이것도 주님의 시련일까요. 이게 대체 뭔 놈의 시련이야! 평소보다 인내심이 짧아졌어!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "……하아. 마스터가 너라서 다행이야. 진심이야, 진심. 다른 사람이었으면 이런 모드로 현계한 모습을 보여줄 수 없는걸.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "이렇게 된 거 어느 정도는 포기하고! 조금은 ‘그 무렵’의 느낌이 나왔지만, 나는 나! 당신이 좋다고 말해준다면, 끝까지 저질러줄 테니까! 그 점은 잘・부・탁・해!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "야곱 님, 모세 님…… 용서해 주세요. 마르타는 주먹을 해방하겠습니다……",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "하기로 했으면 확실하게 하겠어. 얕보지 말란 말이야!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "사랑을 모르는 가엾은 용, 여기에…… 유성처럼! ──타라스크! 세잇! 도망칠 곳은 없어! ──철・권・성・재!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "흥. 다음에 다시 오시지, 한심한 녀석.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "아아아, 저질렀다…… 내가 무슨 짓을……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "내가 좀 풀어졌네…… 한심하게……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "미안, 뒷일은…… 부탁해……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
