    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "마스터, 마스터, 놀자 놀자!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "어이쿠, 마스터, 나에게 뭔가 볼 일이 있어? 볼 일이 없다면…… 놀러 가자! 으음~ 가자니깐~!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "응, 응! 너는 나를 참 좋아하는구나! 알아, 알아! 나는 팔라딘이니까, 그런 건 다 꿰뚫어 본단 말이지!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "냐냐냐냐앗! 앗, 아니, 고양이도 아닌데 냐냐냐는 이상한가. 하지만 마스터! 갑자기 노크하지는 말아 줘! 나도 마음의 준비란 것이 필요하다고.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "지금의 나에게 임금님은 너야! 진심으로 충성을. 그리고 애정이라는 이름의 스파이스를! 너를 마음껏 두근거리게 만들어서 이리저리 휘둘러 주겠어!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "좋아하는 거? 아무것도 생각하지 않는 것일까? 세이버인 나는, 이성이 있는 것이다! 있으므로, 생각하기가 귀찮은 것이다!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 거? 생각하는 것일까! 즉단즉결! 본능으로 움직인다! 이성 따위 몰라~! 그것이 나야!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배라…… 으~음? 음~? 으음~? 가지고 싶은 물건이 많아서 정리가 되지 않으니, 마스터에게 맡길게!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "시작한다~!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "어디어디, 내 검술이 통하면 좋겠는데…… 괜찮으려나, 괜찮겠지!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "좋~아! 해 보자~! 파워업한 내 검술을 보여 주겠어! 업했다는 근거는 없지만.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "메리 크리스마스! 나는 자신이 산타라고 믿고 있는, 딱히 관계없는 아스톨포다! ……아이덴티티, 위기이지 않아?",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "달을 올려다보는 토끼도 이성이 없을 때가 있다. 날뛰는 거인을 붙잡아서! 용감하고 씩씩하게 행진이다! 간다~! ‘요행의 구인망(불카노 칼리고란테)’!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "화려하게 가련하게! 흩날리며 지는 월하미인! 열 겹 스무 겹으로 꽈드드드드득! 좋~아! 나도 참 멋지구나~! ‘요행의 구인망(불카노 칼리고란테)’!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "춤춥니다~! 휘감습니다~! 공격합니다~! 하낫둘! 내 멋진 표정! 귀여워, 멋있어! 어라? 보구명이 뭐였더라? 으아아! 끝나 버렸어~!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "됐다~! 이겼다, 이겼어! 에헤헤. 마스터, 상 줄래?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "봤지! 아스톨포짱 대승리! 어, 뭐? 베낀 거 아니야! 아니라구! 절~대 아니거든!",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "폴짝폴짝폴~짝. 응? 뭐 하고 있느냐고? 신나서 폴짝폴짝 뛰어다니고 있어!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "으~음…… 달에 도착하지 못했어…… 풀썩.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "실패했다~! 어쩔 수 없지, 다음으로 가 보자~!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "달까지 앞으로 9마일은…… 조금 머네…… 하후우……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "왓핫하! 와~핫핫하! 왔어, 왔어, 드디어 왔다 이거야! 클래스, 세이버! 아스톨포! 진짜진짜, 진짜로 가장 우수한 세이버라니깐! 뭐하면 법대로 해도 된다고! 어흠. 아무튼 잘 부탁할게, 친애하는 마스터!",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
