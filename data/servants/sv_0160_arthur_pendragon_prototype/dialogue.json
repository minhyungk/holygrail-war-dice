        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "그런가, 알았다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
