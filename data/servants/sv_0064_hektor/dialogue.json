    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이거야 원, 이 아저씨한테 볼일이라도 있어?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "아킬레우스? 이야아, 두 번 다시 싸우고 싶지 않은데. 그 녀석하고는. 뭐, 그쪽도 그렇게 생각하겠지만.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "어이어이, 괜찮아? 이 아저씨, 이래 봬도 아직 현역이거든?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "어쩔 수 없는 마스터네, 하하하. 그럼, 칠칠치 못한 녀석들끼리 빈둥대 볼까.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터는 이 아저씨한테 트로이 같은 존재야. 온 힘을 다해 사랑하고, 지켜줄게.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "단조롭고 느긋하게 즐겁게 살아가는 거야. 이야, 완전히 이상적 아니냐.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "실은 말이야, 이 아저씨는 몸을 움직이는 게 귀찮아서 참을 수가 없어. 아, 거짓말이야, 거짓말, 거짓말. 버리지 말아줘!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배 말이지. 수상쩍기는 하지만…… 아~ 아무래도 상관없나. 네가 원하면 손에 넣는다. 그것뿐이야.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "귀찮은데, 이 아저씨는 나이가 제법 있거든?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "마스터도 사람 부리는 게 험하네. 아니아니, 일은 확실히 한다니깐요?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "좋아, 어쩔 수 없지. 잽싸게 끝내버리기로 할까.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "적확하고 신속하게, 그렇게 하면 뒷일은 편해지는 법이야.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "표적 확인, 방위각 고정. ‘불훼의 극창(두린다나)’. 날아가 버려!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "부서지지 않고 부러지지 않고 굽어지지 않는, 나의 창은 모든 것을 꿰뚫는다. 산산이 흩어져라! ‘불훼의 극창(두린다나)’!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "자~ 끝났다, 끝났어. 이 아저씨는 잔다. 뒷일은 부탁해!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "이거야 원, 이 아저씨가 또 이겨버렸네.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "승리란 건 어떠한 형태라 해도, 좋은 거야.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "이쪽의 승리인데…… 연장전, 할 거냐?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
