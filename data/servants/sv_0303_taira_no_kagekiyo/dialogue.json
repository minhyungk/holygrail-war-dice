            "gte": 3
          }
        },
        "text": "나의 바람은 단 하나. 즉, ‘겐지, 죽도록 하라’",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
