          "self.intel_level": {
            "gte": 2
          }
        },
        "text": "하늘과, 비와, 일곱 개의 물의 별을 걸고, 완지나는 당신이 마지막 인간이 되도록 놔두지 않겠어. 걱정 마, 걱정하지 마. 응, 웃어보자?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
