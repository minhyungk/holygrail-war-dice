        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_8",
        "text": "이, 이런 것도 가끔은 말이지?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
