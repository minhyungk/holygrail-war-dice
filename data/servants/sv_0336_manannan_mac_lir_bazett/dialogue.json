        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "봉인지정의 집행에 비하면, 이 정도쯤이야.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
