        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "피해.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "싫어.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "미안해요.",
        "source": "fgo",
