        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "노리는 곳은 단 한 곳! 핫!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
