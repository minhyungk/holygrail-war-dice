      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "크헉…… 우아아아아앗!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "큭.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "어떠신지요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "지혜는 불변하는 법입니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "알아야 할 것이 있다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "눈부신 전갈의 꼬리여!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "마스터, 무슨 용건이 있으신지요? 가르쳐 드릴 것이 있다면, 가르쳐 드리겠습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "네, 마스터. 저라면 여기에 있습니다. 뭔가 고민되는 일이라도?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "자, 마스터. 공부하지요. 살아가는 것, 배우는 것. 그것은, 모든 생물의 특권입니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터. 당신에게 가르치고 싶은 것, 전하고 싶은 것이 잔뜩 있습니다. 그렇지만 서번트의 목숨은 한없이 짧지요. 그것이 참으로 아쉽습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "아니, 전하고 싶은 것은 단 한 가지. 당신은 훌륭합니다. 앞으로의 삶에 어떠한 고난이 있다고 해도, 굴하지 않고 앞을 보며 걸을 수 있다…… 당신은 그러한 학생이라고, 저는 확신하고 있습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "좋아하는 것…… 대화를 나누는 일이지요. 어리석다고 매도당하는 인간이 때때로 학자보다 깊은 통찰을 보이는 일도 있거니와, 고명한 철학자가 우스꽝스러울 정도로 아무것도 모를 때도 있고…… 대화란 심오한 것입니다.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것…… 입니까? 뱀과 독일까요. 헤라클레스에게는 비밀이랍니다. 그 남자, 신경 쓰고 있으니까요.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "과거에 하늘에 바친 것을 돌려 달라니, 정말로 꼴사나운 소원이라고 생각합니다만. 그래도, 역시 부모와의 인연은, 소중히 여기고 싶군요.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "그럼, 싸우도록 할까요?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "시작한 이상, 이쪽이 승리를 가져가겠습니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "수업의 시작입니다. 여러분, 이를 꽉 물어 주세요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "그러면 실천의 시간입니다. 각자, 무기를 쥐세요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "이것이야말로 별의 전갈을 꿰뚫는 일격이리니. 나의 화살은 이미 쏘아졌다! ‘안타레스・스나이프(천갈일사)’!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "재앙의 전갈이여, 숙청의 때는 이미 찾아왔다! 별과 함께 스러지도록 하라!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "저격완료. 나의 보구는 이미 성립되었기에…… 전갈의 일격, 차분히 맛봐라!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "경험 부족은 부정할 수 없습니다만…… 뭐, 그것을 보완하는 것이 지혜라는 것입니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "이쪽의 승리입니다. 한두 가지, 가르쳐 드리고 싶은 것이 있습니다만, 괜찮겠습니까?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "어떻게든 승리했습니다. 그러면 가르쳐 드리지요. 아시겠습니까?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "마스터, 방금 전투에 대해서 바로 반성회를 열겠습니다. 아시겠지요?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "패배…… 인가…… 죄송합니다, 마스터……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "여기까지인가…… 아니…… 좋은 싸움이었습니다…… 고맙습니다……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "교사가 학생보다 약해서는 모양새가 나지 않으니까요…… 사적인 감정을 끼워 넣은 것, 용서해 주세요……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "서번트, 아처. 케이론, 찾아뵙습니다. 저의 지식이 조금은 도움이 되면 좋겠습니다만…… 어찌 되었든 잘 부탁드립니다. 당신을 위해, 전력을 다하도록 하지요.",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": 3
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
}
