        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "언제든 묵사발을 내주마.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_5",
        "text": "후훗. 즐겁구나.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
