        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_14",
        "text": "지금이다! 비비비비비비비비!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
