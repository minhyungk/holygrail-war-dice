        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "사냥에는 물러날 때도 중요하다구.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
