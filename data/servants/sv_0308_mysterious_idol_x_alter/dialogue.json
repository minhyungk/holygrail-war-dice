      {
        "id": "fgo_skill_3",
        "text": "달아오르고 있나요~?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "먹는 것도, 일. ……와구와구.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
