    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "여기까지, 네요…… 도움이 못 돼, 죄송해요……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "이곳이 나의, 속죄의 장소…… 로군요……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "소환에 응해 찾아왔습니다! 어쌔신, 샤를로트 코르데입니다! 열심히 노력하겠습니다만, 실패한다면 죄송해요!",
        "repeat": "once_per_run",
