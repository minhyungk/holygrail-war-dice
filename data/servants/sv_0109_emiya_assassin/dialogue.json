        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것? 말할 것도 없지. 세상을 멋지게 구해내겠다는 한심한 소리나 지껄이는 놈을 보면 역겨워.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
