        "quote_verified": true
      },
      {
        "id": "fgo_atk_14",
        "text": "잔상 저 멀리!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "그 혀, 포를 뜨겠쩌여!",
        "source": "fgo",
