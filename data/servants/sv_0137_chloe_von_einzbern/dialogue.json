    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "그렇게나 보고 싶어?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "이렇게 해주길 원하지?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_like",
        "text": "좋아하는 거? 응…… 상성이 좋은 사람일까? 마력을 잔뜩 주는 사람도 좋아하는데?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 거라면 그야 단연코 그거야. 우물쭈물할 때의 이리야! 한번 각오하면 강하지만, 그때까지 오래 걸린단 말이지.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배라…… 사람이 뭔가를 소망하고…… 그걸 이룬다. 그게 선이든 악이든 우리는 그런 삶의 방식밖에 선택하지 못해.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "으~응, 마력이 부족하네…… 어딘가에 마력을 잔뜩 담고 있는 귀여운 여자아이가 없으려나. ……캐스터 클래스가 딱 좋은데.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "응? ……지금 이상한데 만지지 않았어?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이렇게 많은 서번트가 따르고 있다니 당신, 정말 뭐야? 마력이나 정신력 같은 게 어떻게 되어있는 거야? 아니, 가장 이상한 건 그거지, 어떤 영령과도 대화할 수 있는 그 커뮤니케이션 능력…… 자각이 없는 거야?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "당신의 마력은…… 어떤 맛이 날까? 아, 도망치지 않아도 돼, 정말. 바보잖아, 농담이야. ……만약 내가 진심이라면 저항 따위 할 수 없고, 할 생각도 들지 않을걸?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "신기하네…… 당신이 방에 있으니 이렇게 마음이 편하다니. 가족 이외에 이런 기분에 잠긴 건 당신이 처음이야. 잠시만…… 어깨를, 빌려줄래?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "그럼, 기분 좋게 날뛰어 볼까!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "마력은 충분해. 자 상대해 줄게!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "산을 뚫고, 물을 가르고, 그러면서도 절대 추락하지 않는 그 양익……! 학익삼련!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "벌써 끝난 거야? 너무 빨라. 다음엔 힘 좀 써봐.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "휴, 조금 피곤해. 마력공급…… 부탁할게, 마스터.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "마력고갈…… 어이없네……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "당신의 얼굴 기억했어…… 꼭 나중에 눈물 나게 해줄 거야……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "어쩐지 여러모로 신세 지게 된 것 같아. 이대로 작별하는 것도 실례니까, 빚은 갚을게. 응, 분명히 도움이 될 거야. 그도 그럴 것이, 언니 쪽이 뛰어난 게 당연하잖아?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
