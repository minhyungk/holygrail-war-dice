        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "제법 기골이 있는 강자였다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "우리 일족의, 긍지를 걸고……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "그 말은, 하게 두지 않겠다……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "엘도라도의 버서커…… 라고 불리고 있다. 지금은 그걸로 괜찮겠지.",
        "repeat": "once_per_run",
