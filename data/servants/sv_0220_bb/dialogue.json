    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "한여름의 참, 록온!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "선배, 응원 잘 부탁해요!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "부탁이야, 사랑에 시간을.",
