        "text": "이 정도야!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "받아낼 수 있을까……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
