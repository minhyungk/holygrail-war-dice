    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "여기서부터 강하게!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "검은 가슴에, 이지요!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "차분하면서도 경쾌하게!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "포우! 포~우!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
