        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "날 죽일 수 있는 자는 어디에 있지? 후후, 있을 리가 없나──",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
