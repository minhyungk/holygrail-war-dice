        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배인가요. 노코멘트예요. 적어도, 별로 상성이 좋다는 생각은 안 드네요.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
