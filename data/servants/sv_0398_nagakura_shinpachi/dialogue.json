        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "캇!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "흐랴아아아아!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_7",
        "text": "어기 엿차!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_8",
        "text": "누가 늙은이냐!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_9",
        "text": "뭐라고, 이 자식?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_10",
        "text": "바보 자식!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_11",
        "text": "자, 그러면 간다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_12",
        "text": "늙은이 취급하지 마!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_13",
        "text": "너 이 자식!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_14",
        "text": "머리를 깨버린다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "단념…… 해라!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "주절주절 지껄이지…… 마!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_3",
        "text": "길을 비켜라. 나가쿠라 신파치가…… 나가신다!!",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "겨우 이 정도냐!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "어이어이!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_3",
        "text": "크오오오오오옷!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_4",
        "text": "쯧!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "각오해라!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "덤빌 거라면, 목숨은 걸어야 할 걸?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "얕보이면 끝장이지!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "후우…… 잠깐 쉬게 해줘.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "늙은이 취급하지 마. 목숨을 건 싸움이라면 어지간한 놈들한테는 안 밀린다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "아무것도 모르는 놈들이 다 안다는 표정으로 이러쿵저러쿵 지껄이는 건 참을 수 없어! 그래서 내가 신선조에 관해서 글을 남긴 거다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "그런데 내 클래스 말이지. 버서커라는 건 좀 이상하지 않냐? 신선조라면 검사 집단이니까 세이버가 타당하다고 생각하는데…… 응, 뭐라고? 얼굴이 무서워 그런 거 아니냐고……? 얼굴로 정하지 말자?!!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "너처럼 젊은 녀석에게 세계의 명운이…… 아니, 일의 크고 작음은 문제가 아닌가. 우리도 그 무렵에는 검이 전부고 교토의 거리가 세상의 전부였어. 그러니까 너도 자기가 할 수 있는 일을 최선을 다해서 하면 돼. ……하다못해 미련이 남지 않을 정도로 말이야.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "크아~앗! 아무래도 이 모습으로는 늙은이 같은 소리만 하게 돼. 네가 짊어진 게 뭐든, 나는 그걸 믿고 따라갈 뿐이야. 그래, 이 나이를 먹고 뭘 망설이는 거냐. 그럴 짬이 있으면 앞으로 나아갈 뿐이야. 그래, 그 녀석들 몫까지, 내가 해내 주겠어! 안 그러냐, 신파치!!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "좋아하는 거라면 활동사진이지. 지금은 ‘영화’라고 부르던가? 이것만큼은 오래 살아서 다행이다 싶더만.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "신선조를 모르는 녀석은 용서할 수 없지만, 신선조를 바보 취급하는 놈은 더욱 용서할 수 없어! 알겠냐, 그 녀석들을 바보 취급할 수 있는 건, 나뿐이다!!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배? 뭐든 소원을 이뤄준다고? 그런 바보 같은 소리가 어디 있어? 늙은이를 속일 셈이라면 곱게 안 끝날 줄 알라구?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "신선조 2번대…… 라고 해도 모르려나. 됐어, 모른다면─── 알게 해주마.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "그래! 이 나가쿠라 신파치가 진짜 칼싸움을 보여주겠다!",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "젊은이, 눈앞에 지금 누가 있는지 알고 있는 거냐? 여기서 더 나가면, 놀이로는 끝나지 않을 게다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "언제라도 나는, 마구잡이로 돌진할 뿐이야!! 죽여라! ‘용비검’!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "저승길 선물로 감상하고 가라…… 이것이 나가쿠라 신파치의…… 호검이다!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "꿍해 있는 건 이제 사양하겠어…… 간다, 으랴앗!! ‘재넘이・용비검’!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "크카카카카! 나는 평생 현역, 신선조다!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "잘 알았냐, 애송아! 목숨 걸고 싸운다는 건, 이런 거다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "나는…… 아니, 이 몸은! 돌아왔다! 전장에!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "아직, 죽을 수는, 없어……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "한심하구나, 신파치……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "이것이 마지막 상처…… 란 거구나.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "내가 나가쿠라 신파치다. 그래, 그 신선조 2번대 대장. 뭐야, 모습은 이래도 검술은 녹슬지 않았으니까 걱정하지 마. 왜 이래, 거짓말이 아니라니까? 예전에는 동료들 사이에서도 1, 2위를 다투던 실력이었다구. 크카카카카! 젊은 놈들에게 가르쳐주마. ───진짜 칼싸움이란 걸 말이다.",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
