        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_1",
        "text": "견뎌낼 수가...... 큭, 크아아아!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
