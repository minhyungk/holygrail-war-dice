    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "이도/개통 (슈트라세/게헨)",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "추가지원, 준비.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
