        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "우오오오오오오오!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "공연이…… 끝난다……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "죽일 수 있다면…… 벌써 예전에 죽였어……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "나는, 죽음이다. 나는, 신에게 사랑받는 것을 죽여야만 한다. ……나의 이름은 살리에리. 아니. 아니다. 나는, 나는 누구냐…………───",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": 3
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
