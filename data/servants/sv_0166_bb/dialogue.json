    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "우우, 무슨 짓을 하는 건가요!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
