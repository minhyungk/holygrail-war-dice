        "text": "아플걸요? 이거.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "음냐음냐…… 헉?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "훗후후후……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
