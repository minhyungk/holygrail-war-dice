        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "미안하네만 일시후퇴다……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
