    "phase_hit": [
      {
        "id": "fgo_dmg_2",
        "text": "아야!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_1",
        "text": "이런…… 정신 차려, 앤!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "애 많이 썼네, 앤!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "한숨이 나오네요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_like",
        "text": "보물은 좋아하고, 바다도 좋아합니다. 이런 모습이니까요. 어머, 마스터, 부끄러워하나요? 후후후후.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것…… 이성이 보내는 불순한 시선이라든가…… 일까요? 아, 마스터는 예외입니다. 마음껏 봐주세요.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "자, 마스터. 왜 그러시나요? 아, 혹시 보고 싶은가요? 그러거든 이렇게. 후후후.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "저기, 마스터. 앤이 자꾸 들이댈지도 모르는데, 그건 어디까지나 도발이니까. 거기 넘어가면 안 되니까. 넘어가면 경멸할 거야! 경멸! 정말로!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "아, 마스터?! 아, 아뇨, 조금. 쳐다보시는 게 부끄럽다고 할까요…… 아하, 아하하, 무슨 말을 하는 걸까요. 그렇죠?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터, 마스터. 앤이 이상한데, 무슨 짓 했어? ……안 했지? 응, 그건 믿겠는데…… 으음……",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터…… 마스터, 마스터, 마스터. 후후, 신기한 느낌. 한여름밖에 계속되지 않는 감정이었다고 해도, 지금의 저는 행복해요. 예, 정말로!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "[메리] : 원호할게. [앤] : 예, 그럼 잘 부탁드리겠어요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "[앤] : 이런 차림으로 싸우게 하다니…… 마스터는 인간도 아니네요, 후훗. [메리] : 마스터가 잔뜩 항의하고 싶은가 본데……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "[앤] : 이번에는 저부터 가겠어요……! 에잇! [메리] : 도와줄게! 에잇에잇에잇! [앤] : 이걸로 마무리…… Shoot!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "[앤] : 자, 탈탈 털어가도록 하겠어요! [메리] : 영차, 영차.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "[앤] : 메리. 이런 곳에 피가 묻어 있네요. [메리] : 닦아줄래? 땡큐.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "[메리] : 아야야…… [앤] : 너무 방심했군요……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "[앤] : 으음, 아쉬워라. 미안해요, 마스터. 안녕히 주무세요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "자, 마스터! 이 수영복, 어떤가요? ……시선이 음흉하네요, 마스터. 흥.",
        "repeat": "once_per_run",
        "source": "fgo",
