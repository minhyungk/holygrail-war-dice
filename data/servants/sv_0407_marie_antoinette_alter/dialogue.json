        },
        "text": "성배는 멀리 치워둬. 나는, 피와 복수를 원하니까!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
