        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "자, 속사 승부다. 먼저 뽑아도 좋아. 내 쪽이 빠르니까. 파이어……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
