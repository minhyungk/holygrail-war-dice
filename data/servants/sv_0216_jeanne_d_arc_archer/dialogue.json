    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "아야야야야얏! 조, 조금 힘들어요!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
