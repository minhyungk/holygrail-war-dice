      },
      {
        "id": "fgo_atk_5",
        "text": "이얍!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "이거면…… 어떠냐!",
