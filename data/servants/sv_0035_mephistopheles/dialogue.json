        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "양 눈, 옆구리, 무릎, 척수. 설치 완료! ──틱탁 봄! 아하하하하하하!",
