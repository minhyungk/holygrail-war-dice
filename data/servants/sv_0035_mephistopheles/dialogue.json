            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "히야~하하하하! 이~히히히!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
