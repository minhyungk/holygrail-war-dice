      },
      {
        "id": "fgo_atk_4",
        "text": "솔개야, 부탁할게.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "솔개야, 잘 부탁해?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "빛이 있으라!",
