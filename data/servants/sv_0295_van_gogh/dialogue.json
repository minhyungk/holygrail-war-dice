        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "죄송해요…… 죄송해요……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "서번트・포리너. 보시는 대로, 고흐입니다…… 같이 세계를 덧칠해요. 노, 농담이에요, 우후후, 에헤헤……",
        "repeat": "once_per_run",
