    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "저기, 이리야라고 합니다. 초등학교 5학년입니다. 일단…… 마법소녀, 하고 있습니다, 네. 으으, 저 같은 게 무슨 도움이 될지 모르겠지만…… 하지만 열심히, 노력하겠습니다! 루비짱도 있습니다! 재미있고 귀엽게 해나가죠, 그랜드 마스터!",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": { "gte": 2 }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
