    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이런, 마스터인가…… 무슨 용무지?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "마스터인가. 무슨 일이 있었나? 호위 임무라면, 기꺼이 맡겠어.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "왜 기도를 하느냐…… 좋은 질문이군. 나의 기도가 신께 닿는다 해도 신께서 그 기도에 응할지는 알 수 없어…… 그런 의미에서는 무의미하다고 할 수도 있지. 그러나 기도에 항상 의미가 있다면, 그것은 결국 상거래일 뿐이야. 이익이 없기에 하는 기도─── 그것이, 신앙일지도 모르겠군.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "서번트는, 마스터를 지키는 법이지만…… 나는 그중에서도 수호에 특화되었어. 실더는 아니지만 말이지. 여차하면, 그래…… 말에는 탈 수 있겠지? 너를 안전하게 피신시키는 것에 전념하도록 하지!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "과연…… 그런 일이 있었나. 기록은 있지만 실감은 없군. 그쪽의 나에게는 어지간히도 강렬한 추억이었던 것이겠지. 그렇다면 그 남자의 긍지를 더럽히는 짓은 할 수 없겠어. ……그건 그렇고, 운명이란 기묘한 변전을 보여주곤 하는군.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "좋아하는 것이라…… 체스나 장기는 취향이군. 마작은 못하겠어. 운의 요소가 너무 강해. 트럼프는, 게임 나름일까?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것이라…… 지켜내지 못하는 거겠군. 농성전도 좋아하지는 않아. 특히, 희망이 없는 농성전은 말이야……",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배라…… ……아니, 빌만한 것은 아무것도 없어. 네가 자유롭게 소원을 빌도록 해. 그 소원이, 내가 지켜야 할 법을 위반하지 않는 한, 전력으로 이루어주겠어!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "맞서 싸우자! 우리의 위대한 조국을 위하여!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "난적을 앞에 둔다는 것이, 이 얼마나 행복한 일인가……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "부디 이 손에 검을 쥐는 것을 용서하소서! 간다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "숱한 침략이 있어도 우리의 신앙을 당해낼 것은 없다! ‘맹세하는 것은 삼중의 귀벽(테오도시우스 콘스탄티누스)’!! ───우리는 결코 꺾이지 않는다…… 이 몸이 사라질지라도 나의 조국은 영원하리라!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "멸망, 이라─── 아니, 결코 멸망하지는 않는다! ‘맹세하는 것은 삼중의 귀벽(테오도시우스 콘스탄티누스)’!! 나는 여기에 있다! 여기에 있단 말이다!! 우리야말로 진정한 벽이다!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "방심하지 마라! ……후우. 아니, 실례. 지금은 축하할 때인가……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "개선의 시간이다! 자, 함께 가자!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "간신히 승리를 건졌나…… 잘했다, 다들!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "이겼나……! 하지만 진정한 승리인지를 판가름하는 건, 지금부터다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "다들 물러나라! 내가, 지켜야만……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "윽…… 움직이지 않아…… 여기까지인가…… 미안하다, 마스터……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "서번트, 라이더…… 콘스탄티누스 11세. 신성하고도 위대한 로마, 최후의 황제이고자 하는 자다. 너의 소원이 이루어지도록 전력을 다하마.",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
