        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "이 싸움, 이길 수 있나───?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "전진뿐이다!",
