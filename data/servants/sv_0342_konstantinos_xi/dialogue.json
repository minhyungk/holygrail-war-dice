    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "모두에게 고한다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
