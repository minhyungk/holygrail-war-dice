    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "그만둬……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "네 이놈……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "포기할 줄을 모르네.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "이제 그만 편해지는 게 어때?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "분명히 시황제의 말에도 일리는 있었고, 영령이 되어 봤지만…… 설마 너와 계약하는 꼴이 될 줄은 생각도 못 했어! ……아아, 정말! 어떻게 이런 일이 있을 수 있담!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이런 형태로 인간들을 돕는 꼴이 될 줄이야…… 돌이켜보면, 애초에 마리스빌리 따위의 권유를 받아들인 게 커다란 실수였어.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이해하고 있는 거야?! 나는 정령, 너는 인간. 비슷한 것은 모습뿐. 절대 서로 받아들일 수 없는 존재라니까?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "……그러네. 너를 뻔한 인간이라고 생각했던 것이 잘못이었는지도 몰라. 수많은 영령과 인연을 맺은 마스터라면, 나를 괴물이라며 혐오할 이유도 없는 게 당연하겠지.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "인간의 형태를 한 인간이 아닌 자에게, 안식의 장소 따위 없다── 계속 그렇게 생각하고 있었어, 이렇게 서번트가 될 때까지는 말이지. 앞으로 어떤 운명이 기다리더라도, 지금 이 순간에 느낀 안식을, 나는 영원히 잊지 않겠지.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "말하지 않는 생명. 있는 그대로의 모습으로 찰나의 봄을 구가하는 자들. 그런 존재 방식은 사랑스러워. 끝이 없는 생명의 연쇄. ……나는, 방관자밖에 될 수 없지만.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것? 알고 있잖아? 인간이야. 너도 그 일원이니까, 잊지 말도록 해.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배라…… 그런 수상쩍은 물건에 눈이 흐려져서 바로 손을 뻗다니, 정말이지, 인간 녀석들은 어쩔 도리가 없다니까.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "너무 번거롭게 하지 말아 줄래?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "아아── 이렇게 꼴사나울수가",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "멸망의 운명에게조차 버림받은, 내 영원의 통곡──. 하늘이여! 구름이여! 슬픔의 눈물로── 생명을 저주하라!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "멸망을 아는 자── 언젠가 안식을 얻는 과보자들이여. 나의 선망! 나의 증오! 죽음의 고통으로써 알도록 하라!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "평온하게 죽은 얼굴…… 부러워.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "죽인다고 죽을 수 있다니, 행복한 사람이네.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "이 고통만은…… 익숙해지지 않아……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "다음에 만나면…… 갈기갈기 찢어주겠어……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "저기 말이야, 잘도 뻔뻔스럽게…… 하필이면 네가 나를 소환하다니, 대체 정신이 어떻게 되어 먹은 거야?! 흥, 뭐, 좋아. 인연이 있던 것 또한 사실이니. 서번트, 어쌔신. 그 계약에 응해줄게.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
}
