      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "그럼 이것을.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "좋아, 간다.",
