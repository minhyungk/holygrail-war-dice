    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "황금률에도 종류가 있다고.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "응! 이 앵글, 딱 좋아!",
        "source": "fgo",
