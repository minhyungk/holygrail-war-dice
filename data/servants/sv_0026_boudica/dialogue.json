            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "응. 내가 여왕이라는 게 의외야?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
