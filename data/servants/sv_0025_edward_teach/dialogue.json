    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "헤이헤이, 피처 베이비!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "이것이…… 사랑!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "파이러츠라는 단어, 어쩐지 불끈불끈하지 않아~? 소생은 그렇습니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "해적의 무서움을 보여주겠어.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
