      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "번거롭게 만들지 마라.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "파워~ 업! 이라는 것이다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "기대…… 하고 있는 게지?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_like",
        "text": "뭐든지 화려하고 호화로운 것이 좋다. 풍족하다는 이야기니 말이다, 그건!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것은 고양이와 유령…… 헉?! 어, 어째서 내가 약점을 알려줘야 하는 게냐!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배라…… 아직 보지 못한 그것보다, 지금은 손에 닿는 곳에 있는 것을 소중히 여겨야겠지.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "네놈을 마스터라고 불러주긴 하겠다. 하지만 그것과 관계없이, 어느 쪽이 위인지는 이미 절대적으로 정해져 있다. 나를 숭상하고 경배하기를 잊지 말도록 하라!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "마스터, 지루하구나, 지루하다고~. 말을 듣지 않는 서번트의 밀고 정보 같은 건 없느냐?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "최근, 마스터의 시선이 자주 느껴지는구나…… 후후후. 나의 요염함에 참을 수 없어진 게냐? 나는 참으로 죄 많은 여자로고.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터, 저기…… 지금만은 특별하게…… 나를 칭찬하기를 허락해 주지 못할 것도 없다만? 이렇게, 쓰다듬어 준다든가, 달콤한 사탕을 준다든가! 자, 어서 사양하지 말거라! 자아!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "진명도 모르는 서번트를 이렇게까지 중용하다니, 네놈은 참으로 어리석구나. 그러나…… 그 어리석음에는 보답해줘야겠지. 좋다, 네놈에게 언젠가 나라를 하사하도록 하마. ……후후, 내 이름을 알면, 농담이라고는 생각하지 못하게 될 터인데?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "내가 진명을 밝히면, 네놈들은 다리가 후들거릴 것이라니까~?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "내가 나설 차례인가!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "증오해야 할 것은 그대가 아니라, 그대들 안의 죄! 나의 법은, 그 모든 죄를 고통의 기술로 끌어낸다! 마음껏 맛보도록 하라! ……니핫!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "쿳훗후. 내 섭리의, 시범 체험 캠페인이다! 어떠한가? 이 실로 공정하며 공평한 고통! 사양하지 말고 찬사를 보내도 좋은데 말이다? ……니핫.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "증오해야 할 것은 그대가 아니라, 그대들 안의 죄! 나의 법은, 그 모든 죄를 고통의 기술로 끌어낸다! 마음껏 맛보도록 하라! ……니핫!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_4",
        "text": "기뻐하고 있을 수만은 없겠지만…… 그대는 운이 좋다는 걸 아느냐? 나의 공무를, 누구보다도 가까이서 볼 수 있으니 말이야! 고문! 고문! 또 고문! 이다! 뉴, 후후후후~.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "오늘의 고문, 이것으로 종료!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
