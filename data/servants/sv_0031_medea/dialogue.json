        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_01",
        "text": "어머, 이걸로 끝?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_02",
        "text": "패자답게, 도망치듯이 떠나갔네.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "crisis": [
      {
        "id": "base_01",
        "text": "……큭, 이 내가 이런 꼴이라니. 두고 봐.",
        "tone": "defiant"
      },
      {
        "id": "base_02",
        "text": "마스터, 조금만 시간을 벌어. 술식을 다시 짤 테니까.",
        "tone": "defiant"
      },
      {
        "id": "again",
        "when": {
          "mem.near_death_count": {
            "gte": 1
          }
        },
        "text": "또……? 정말이지, 짜증 나는 전쟁이네.",
        "repeat": "once_per_run",
        "tone": "grim"
      }
    ],
    "seal_use": [
      {
        "id": "buff",
        "when": {
          "event.purpose": "buff"
        },
        "text": "영주를 쓰는 거야? 흐응, 제법 과감하네. 좋아, 받아 주지."
      },
      {
        "id": "np",
        "when": {
          "event.purpose": "np"
        },
        "text": "맡겨 둬. ──계약도, 섭리도, 전부 처음으로 되돌려 주겠어.",
        "notes": "FGO 보구 영창의 오마주"
      },
      {
        "id": "escape",
        "when": {
          "event.purpose": "escape"
        },
        "text": "물러나자고? ……현명하네. 싸움은, 끝까지 살아남는 쪽이 이기는 거니까."
      },
      {
        "id": "block_betrayal",
        "when": {
          "event.purpose": "block_betrayal"
        },
        "text": "……영주로 나를 묶겠다는 거야? 흥. 마스터란 다 그렇지."
      }
    ],
    "draw": [
      {
        "id": "base_01",
        "text": "무승부? 시시하네. 다음엔 끝장을 보자."
      }
    ],
    "execute": [
      {
        "id": "base_01",
        "text": "그래, 그래야지. 적에게 동정 같은 건 사치야.",
        "notes": "성향 악: 처치 시 호감도 상승 (D-056)"
      }
    ],
    "release": [
      {
        "id": "base_01",
        "text": "살려 보낸다고? ……어리석긴. 그 달콤함이, 언젠가 당신의 목을 조를 거야.",
        "notes": "성향 악: 방면 시 호감도 하락 (D-056)"
      }
    ],
    "intel": [
