      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "오오! 마스터. 뭐야, 시간이 남아돌아?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "이봐, 마스터. 슬슬 마을로 나가보자고~ 여자가 나를 기다리고 있다구~",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "좋아! 마스터. 잠깐 비행기 놀이를 해 주지! 1, 2, 3! ……카하하! 미안, 놀라게 했네.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "마스터, 나하고 너무 친하게 지내지 않는 편이 좋을 거야. 아르테미스라든지, 질투에 관해서는 의외로 남녀 구별이 없으니까. 그리스 신이란 이래서 원……",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "옷, 마스터인가! 얼마 전에 한 말은 잊어줘. 하여간, 일단은 마스터와 서번트로서 건전한 교제부터 시작하자는 얘기야. 아르테미스와 함께, 잘 부탁해!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "좋아하는 것? 사냥, 여자 꼬시기, 끝! 서번트 매칭 앱 같은 것은 사용하지 않는 편이 좋을 거야. 이상하게도 아르테미스밖에 표시되지 않는다고.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것? 그야 당연히 신들이지! 그놈들은 진짜 이해할 수 없는 사고회로를 지녔으니까! ……물론 아르테미스 씨는 예외랍니다. 예외예외! 노카운트, 노카운트!! 히이이익!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배…… 여자랑 건배할 때 써도 돼? 안 돼? 아, 그래.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "하하하하앗! 가볍게 비틀고 꼬고, 그런 뒤에…… 꺾어버려 주마~!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "아아~ 이거야 원! 어쩔 수 없네…… 짓뭉개 버리도록 할까!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "전투지만 그 전에…… 귀여운 여자와 인연이 있기를…… 기도 끝! 간다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "미안하지만 이번에는 진심이야…… 때려 부수겠다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "나의 숙명, 달의 여신에게 청한다. 육체에 굳센 힘을, 정신에 냉철함을. 그리고 내 운명을 여기서 규정하겠다. ‘달의 여신의 무구한 사랑(아르테미스 아그노스)’. ……충전 완료! 간다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "아르테미스, 그 힘을 빌려줘. 너와 함께라면 질 것 같지 않아. 좋았어, 한 방 날리지! ‘달의 여신의 무구한 사랑(아르테미스 아그노스)’! 용기백배! 해치워 주마!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "아! 왠지 안 좋은 예감이 들어! 큰일 났다, 아르테미스가 화났어! 뭔가 들켰나 봐! 보구 중지, 중지! 싫어어! 목 조르지 마! 아니, 어라? 꿈인가?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_4",
        "text": "마스터갑작스럽지만바람피던걸들킨터라죄송합니다잠깐철수하겠습니다! 어? 안 돼? 힉, 아르테미스 씨……! 끄아아아아! ‘달의 여신의 무구한 사랑(아르테미스 아그노스)’!! ……아, 사랑이, 무거워……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "읏샤, 이겼다, 이겼어! 자, 그럼, 짐승이었다면 갈무리하고 나서 먹어버리자고!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "미안하게 됐네, 나에게는 행운과 불행을 한꺼번에 가져다주는 여신이 붙어 있거든.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "으랏차, 승리! 자! 히로인을 만나러 가자고!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "아르테미스는 없겠지…… 없어? 좋아! 그러면 시내로 나가자! 여자가 나를 기다리고 있을 거야!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "젠장…… 나 정도 되는 녀석이…… 미안……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "그리스 제일의 사냥꾼이, 이 무슨 꼬락서니야…… 헷.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "미안…… 아르테미스…… 너의 긍지를……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_4",
        "text": "아르테미스…… 보이지 않아…… 아무것도……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "엇? 뭐야. 나를 소환한 거냐? 내 이름은 오리온! 인간의 몸을 초월한 느낌의 사냥꾼이다! 아~…… 어흠, 인간을 초월하긴 했는데, 그것과는 별개로 욕망은 인간하고 똑같아서 말이지. 에~ 그 뭐냐, 그러니까…… 나를 좋아하는 여자라든가, 있어?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
