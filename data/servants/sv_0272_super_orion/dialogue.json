    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "축복 따윈 저주 같은 거라구~",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "천하무쌍의 힘, 보여 주마아!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "조준하고…… 엿차.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "불평은 여신님에게 부탁해!",
