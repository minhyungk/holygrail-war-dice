        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "성배……? 음. 솔직히 말해서 잘 몰라. 남미라면 성체배령이 기본이랄까……",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
