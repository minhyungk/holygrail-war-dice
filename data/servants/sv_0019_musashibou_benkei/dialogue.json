        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "꺼리는 것을 물어보시는 겐가. 슬픈 사랑, 비극, 그러한 것은 즐기지 않습니다.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
