          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          },
          "self.intel_level": {
            "gte": 2
          }
        },
        "text": "예, 예, 키요히메는 여기에 있답니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
