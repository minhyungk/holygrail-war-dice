        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "싸우는 맛이 없군.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
