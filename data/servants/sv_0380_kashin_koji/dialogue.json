{
  "speaker": "sv_0380_kashin_koji",
  "defaults": {
    "status": "draft",
    "author": "ai",
    "weight": 1,
    "repeat": "always",
    "source": "fgo"
  },
  "notes": "D-157 자동 편입. 대사는 Atlas KR 보이스(scripts/fetch-voices.mjs)만 들어 있고, 없는 상황은 클래스·공통 대사층이 맡는다 (D-143).",
  "tags": {
    "phase_win": [
      {
        "id": "fgo_atk_1",
        "text": "우선, 손부터.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_2",
        "text": "팔 부분 병장 전개.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_3",
        "text": "칼날을.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_4",
        "text": "벨게요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "화염입니다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "다리 부분 병장, 전개.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_7",
        "text": "나의 외술.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_8",
        "text": "어떻습니까?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_9",
        "text": "카신 병장, 거미등롱.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_10",
        "text": "파아───!!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_11",
        "text": "인법, 팽이 돌리기.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_12",
        "text": "후마 직접 전수.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_13",
        "text": "인법, 장맛비.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_14",
        "text": "헤잇!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "허도 실도, 사람을 죽이겠습니다……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "쉬십시오, 안녕히.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_3",
        "text": "외술, 오츠치구모.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_4",
        "text": "나의 왼쪽 눈───!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "우아아아아아앗?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "그렇습니까.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_3",
        "text": "아아, 아프다……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_4",
        "text": "아프네요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "살육 꼭두각시, 확인.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "죽이겠습니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "나는.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "네, 어떤 모습으로도.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_5",
        "text": "눈은, 좋아요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_6",
        "text": "내 왼쪽 눈, 볼래?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_7",
        "text": "우후, 우후후후후후후!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          },
          "self.intel_level": {
            "gte": 2
          }
        },
        "text": "네, 카신 거사입니다. 별 볼 일 없는 외술사입니다. 모쪼록 잘 부탁드립니다. 네.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "닌자의 기술도 씁니다. 바라신다면 적의 목, 사냥해 오겠으니 사양 말고 분부해 주세요.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "사람인가, 꼭두각시인가. 저는 대체 어느 쪽이라고 생각하십니까, 마스터? 자, 어느 쪽일까요? 어쩌면 양쪽 다 아닐지도 몰라요──",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "저의 몸…… 거의 모든 육체를, 기계장치로 바꾸었습니다. 뼈는 전부 기계장치입니다. 심장도, 폐부도, 머릿속도. 미약한 잔재를 제외하면 확실한 형태로서 남은 것은 이 왼쪽 눈 정도겠지요. 기억 전부를 잃어도 저는 이 붉은 눈만은 버릴 수 없었습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "알고 계시나요, 마스터? 옛말에 전하길, 붉은 눈이란 마성의 증거라더군요. 그렇다면 저는…… 아── ……네? 말하지 않아도 된다? 그렇습니까…… 그렇, 습니까.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "멋진 것을 좋아합니다. 저의, 텅 빈 가슴을, 가득 메워 줄 반짝거리며 빛나는 것을, 좋아합니다.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "싫어하는 것은, 없습니다. 정말이에요?",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "소원을 이루어주는 잔? 그렇습니까, 그런 것이 있다고.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "멋집니다. 멋져요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "아아…… 생명의 냄새가 난다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "명령을 내려주신다면, 당장에라도.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "그러면, 그 목숨을 받아 가겠으니──",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "마안 기동, 전 카신 병장, 병렬 기동. 섬멸─── 섬멸, 섬멸, 섬멸───! ‘꼭두각시 외법・사자분신’!! ───수급을 주세요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "붉은 눈을 부릅뜨고, 강철의 주검이 꽃핀다. 여기에서, 각오하소서! ‘꼭두각시 외법・사자분신’!! ───그 목, 받았다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "붉은 마여, 오너라. 강철을 버팀목 삼아 기원을 이룰지어다. 잘 보아라, 이것이 바로 나의 몸, 나의 형상! 눈에 새기고 저승에 떨어져라! ───금기이기에, 실례.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_4",
        "text": "붉은 마여, 오너라. 강철을 버팀목 삼아 기원을 이룰지어다. 잘 보아라, 이것이 바로 나의 몸, 나의 형상! ‘이블 윈드・데스 슬래시’!! ───금기이기에, 실례.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "아주, 멋졌답니다?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "이것으로 종료. 어떻습니까? 마스터.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "잠깐, 주우러 가겠습니다. 네.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_4",
        "text": "생명의 냄새, 사라져 버렸군요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "시야 불량, 시야 불량…… 안, 보, 여.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "기능, 정지.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "아직…… 움직일 수, 있습, 니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_4",
        "text": "아아…… 왼쪽 눈이…… 뜨거워.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "카신 거사라고 합니다. 이 임시 생명이 있는 한, 당신을 섬기겠습니다. ───앞으로 잘 부탁을.",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
}
