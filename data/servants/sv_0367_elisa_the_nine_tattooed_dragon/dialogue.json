    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "구문룡은 코 잘래…… 잠깐, 잘게……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
