{
  "speaker": "sv_0434_servant_434",
  "defaults": {
    "status": "draft",
    "author": "ai",
    "weight": 1,
    "repeat": "always",
    "source": "fgo"
  },
  "notes": "D-157 자동 편입. 대사는 Atlas KR 보이스(scripts/fetch-voices.mjs)만 들어 있고, 없는 상황은 클래스·공통 대사층이 맡는다 (D-143).",
  "tags": {
    "phase_win": [
      {
        "id": "fgo_atk_1",
        "text": "산신의 가호라면, 이와 같이.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_2",
        "text": "갑니다, 일의전심!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_3",
        "text": "거꾸로 꽂은 칼, 기는 것을 허락치 않나니!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_4",
        "text": "나의 몸으로 대신하더라도 닿게 하겠다!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "소녀의 흑발, 영묘하리니!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_6",
        "text": "인도하라, 머리카락이여. 하앗!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_7",
        "text": "지고쿠다니의 염열처럼!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_8",
        "text": "각오하시길. 에잇, 얍!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_9",
        "text": "흩날려라, 화염의 모침!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_10",
        "text": "삿된 것을 정화하소서!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_11",
        "text": "스물하고도 한 번, 돌아볼까요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_12",
        "text": "이러한 불가사의도 있지요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_1",
        "text": "수호의 거울이여, 앞길을!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_2",
        "text": "신불이여, 부디!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_ex_3",
        "text": "오악의 하늘에, 빛을!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "phase_hit": [
      {
        "id": "fgo_dmg_1",
        "text": "좋지 못한, 일입니다……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_2",
        "text": "으윽?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_3",
        "text": "어째서, 이런……?!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_4",
        "text": "큭!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "나는, 어떠한……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "산의 바람이……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "갈고 닦은 마음을.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_4",
        "text": "아쉬워할 것도 아닙니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_5",
        "text": "바라건대, 흐리지 않기를.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_6",
        "text": "인도하심, 일까요.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "day_bond": [
      {
        "id": "fgo_bond_1",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "지금은 전시, 난세의 한복판이지요. 영주의 딸로서 격식을 갖춘 대접은 할 수 없겠습니다만, 부디 너그럽게 보아 주시길.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_2",
        "when": {
          "self.affinity_tier": {
            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "솔직히 말하면, 깜짝 놀랐습니다. 당세에는 이렇게 메밀국수의 종류가 많아졌을 줄이야. 어느 것이나 다 맛있어 보여서 고민되네요.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "으음…… 으으으으음…… 마스터 님, 실례인 줄 압니다만 저, 도저히 참을 수 없습니다! 간청하오니, 부디, 당신의 머리카락을 다듬게 해주실 수 없을는지요. 머리카락 끝을 정리하는 것만으로도 충분하니까요!",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_4",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "머리를 다듬는 것은 칼로 하느냐고요? 아뇨, 당연히 가위를 빌릴 요량이었습니다만…… 그러나 칼날은 칼날. 마스터 님의 소중한 머리카락을 매만지는 것이니, 특별히 힘 있는 칼날인 편이 좋을 수도…… 그렇게 생각하면 칼을 쓰는 것도 방법 중 하나일지도 모르겠네요. ……“부탁이니까 가위로”? 네, 알겠습니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_bond_5",
        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "싹둑, 싹둑…… 싹둑, 싹둑…… 우후후. 이러고 있으니…… 어릴 적에 어머니가 머리를 손질해 주시던 때가 떠오릅니다. 조용하고, 소중한 사람의 손이 따뜻해서…… 무척 따스한, 마음이 차분해지는 시간. 당신에게도 지금이 그런 시간이라면 좋겠네요. 그러니까, 네. 주무셔도 상관없답니다. 괜찮아요, 일어나서 보니 이상한 머리모양이 되어 있을 일은─── 글쎄요? 당세의 머리모양 사정에는 어두우니, 혹시 모르죠……? 우후후, 농담입니다.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_like",
        "text": "이곳에는 아름다운 머리카락을 가진 분이 많아서, 손질해 드릴 기회를 얻기만 해도 행복한 기분이 듭니다. 그 밖에는, 그러네요…… 원숭이도, 좋아한답니다. 귀여워서.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dislike",
        "text": "머리카락이 상할 만한 행위는, 별로 좋아하지는 않네요. 고운 머리카락에는 힘이 깃드는 법. 모두, 소중히 여기셔야 한다고 생각합니다.",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_grail",
        "when": {
          "world.day": {
            "gte": 3
          }
        },
        "text": "모든 소원을 이루어주는 성배, 라고요. 탐욕스러운 뱀이 좋아할 듯한 기척이 느껴집니다. 조심해야 하겠습니다. 그러나 좋아하는 자만 곁에 있으면 된다는 식의, 한결같고 편식하는 뱀에게는 쓸데없는 물건일지도 모릅니다. 사람마다 제각각…… 아뇨, 뱀마다 제각각, 이라는 뜻일까요.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "타카나시의 쿠로히메, 갑니다.",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "내가, 바라는 것은───",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_3",
        "text": "행해야 할 일을.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_4",
        "text": "양갓집 규수라 해도 칼은 휘두를 수 있습니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "타카나시의 쿠로히메, 나의 머리카락과 보검을 여기에 바친다. 마땅히 있어야 할 곳에, 부디 닿게 하소서! ───이리하여 전하노니, 카미나가시.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "나라를 수호하는 검이여, 인도의 머리카락과 함께 흘러 삿된 것을 정화하라. 가호의 끝에 칼날은 용과 뱀에 닿으리라. ‘쿠로히메 이야기・카미나가시’───",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "이 영험함은, 골짜기를 굽어살피는 산신의 가호이리니. 머리카락이여, 칼날이여, 뱀의 불제를 이을지어다. 마흔여덟 곳의 못이여, 끓어올라 사라져라!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "길을, 부디 가리켜 주소서.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_2",
        "text": "지금, 뱀 없었나요?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_win_3",
        "text": "머리카락이, 흐트러지고 말았습니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "역시, 몸을 바치는 것이, 운명……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "이리하여 오악의, 이슬로 사라지나니……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_3",
        "text": "뱀이여, 어디에……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "시나노의 타카나시 가문의 여식, 쿠로히메라고 합니다. 저 같은 자가 검사라니, 다소 민망하기도 합니다만…… 저희 가문에 전해지는 보검의 힘이 있으면, 뭔가 할 수 있는 일도 있을 테지요. 부디, 잘 부탁드립니다……",
        "repeat": "once_per_run",
        "when": {
          "self.intel_level": {
            "gte": 2
          }
        },
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
}
