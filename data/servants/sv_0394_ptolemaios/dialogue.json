      },
      {
        "id": "fgo_skill_2",
        "text": "오오오오오옷!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_3",
        "text": "그 이야기의 다음은, 말이지.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
