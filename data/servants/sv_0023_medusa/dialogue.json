    "draw": [
      {
        "id": "base_01",
        "text": "……결판은, 나중으로 미루죠."
      }
    ],
    "execute": [
      {
        "id": "base_01",
        "text": "……마스터의 결정이라면. 하지만, 굳이 그럴 필요가 있었을까요.",
        "notes": "성향 선: 처치 시 호감도 하락 (D-056)"
      }
    ],
    "release": [
      {
        "id": "base_01",
        "text": "……다행이에요. 필요 이상의 피는, 보고 싶지 않았으니까.",
        "notes": "성향 선: 방면 시 호감도 상승 (D-056)"
      }
    ],
    "intel": [
      {
        "id": "success",
        "when": {
          "event.result": "success"
        },
        "text": "흔적이 남아 있었습니다. {enemy}{은/는} 이 근처를 지나갔어요."
      },
      {
        "id": "level1",
        "when": {
          "event.result": "success",
