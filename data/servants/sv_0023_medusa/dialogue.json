        },
        "text": "진명을 알아냈습니다. {enemy}── 그렇다면, 대책은 세울 수 있어요."
      },
      {
        "id": "fail",
        "when": {
          "event.result": "fail"
        },
        "text": "……찾지 못했습니다. 죄송합니다."
      }
    ],
    "day_bond": [
      {
        "id": "urban",
        "when": {
