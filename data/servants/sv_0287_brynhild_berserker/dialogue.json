    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "[브륀힐드] : “저만으로는 이룰 수 없습니다. 당신과 함께라서 이룰 수 있는 거예요.” [시구르드] : “같이 가자.” [브륀힐드] : “네!” [함께] : “‘적어도, 죽음의 찰나까지는(브륀힐드・시구르테인)!’”",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "[브륀힐드] : “시구르드, 사랑스러운 당신.” [시구르드] : “사랑하고 있어, 브륀힐드.” [브륀힐드] : “가죠.” [시구르드] : “그래.” [함께] : “‘적어도, 죽음의 찰나까지는(브륀힐드・시구르테인)!’”",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_3",
        "text": "[시구르드] : “그러면, 시작하자, 내 사랑.” [브륀힐드] : “네, 시구르드.” [시구르드] : “이것이야말로, 사랑의.” [브륀힐드] : “공동작업.” [함께] : “‘적어도, 죽음의 찰나까지는(브륀힐드・시구르테인)!’”",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
