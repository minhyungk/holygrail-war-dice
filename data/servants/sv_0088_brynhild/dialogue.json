        "text": "아앗……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_dmg_1",
        "text": "이것은, 아픔……?",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
