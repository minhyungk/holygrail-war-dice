    "battle_start": [
      {
        "id": "fgo_start_1",
        "text": "가능한 한, 절망을 노래해 줘.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_start_2",
        "text": "자, 유린과 학살의 시간이야. 반항해 봐, 전력으로.",
