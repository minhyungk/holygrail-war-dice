            "in": [
              "neutral",
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "불경하잖아. 죽이겠어.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
