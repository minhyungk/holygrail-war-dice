        "when": {
          "self.affinity_tier": "loyal"
        },
        "text": "하여튼간에…… 짓궂네, 당신. 나보다 심술궂다니 대단해.",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "tender",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
