    "skill": [
      {
        "id": "fgo_skill_1",
        "text": "죽음이여, 명부여.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_skill_2",
        "text": "훗후후……",
