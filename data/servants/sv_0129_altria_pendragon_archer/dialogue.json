        "quote_verified": true
      }
    ],
    "np_open": [
      {
        "id": "fgo_np_1",
        "text": "스위밍의 시간입니다! 수면에 빛나는 것은 승리의 검! 엑스칼리버, 비비안───!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_np_2",
        "text": "스위밍! 화려, 너무나도 화려! 돛대와 흩어져라, 엑스칼리버, 비비안───!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "victory": [
      {
        "id": "fgo_win_1",
        "text": "해변은 깨끗하게. 무슨 일이든 뒷정리가 중요합니다.",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
