        "quote_verified": true
      }
    ],
    "defeat": [
      {
        "id": "fgo_down_1",
        "text": "조금 더…… 쏘고 싶었…… 는데……",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_down_2",
        "text": "다음에는 머신건을 가져오겠습니다……!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ],
    "summon": [
      {
        "id": "fgo_summon",
        "text": "아, 안녕하십니까! 아처, 알트리아, 소환에 응해 찾아왔습니다. 익숙지 않은 클래스라서 도움이 될지 모르겠습니다만, 잘 부탁드리겠습니다!",
        "repeat": "once_per_run",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      }
    ]
  }
