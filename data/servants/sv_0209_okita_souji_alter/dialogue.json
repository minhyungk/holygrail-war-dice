        "quote_verified": true
      },
      {
        "id": "fgo_atk_4",
        "text": "마신의 마는, 마구 베기의 마!",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
      },
      {
        "id": "fgo_atk_5",
        "text": "마신의 신은, 신나게 베기의 신!",
