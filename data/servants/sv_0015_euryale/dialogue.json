      {
        "id": "fgo_bond_3",
        "when": {
          "self.affinity_tier": {
            "in": [
              "friendly",
              "loyal"
            ]
          }
        },
        "text": "외로운 마음은 당신이 메꿔줘. 알았지, 마스터? 그것이 당신의 앞으로의 일이야. 열심히 노력해 보여줘야 해?",
        "weight": 2,
        "repeat": "once_per_run",
        "tone": "calm",
        "source": "fgo",
        "quote_of": "Fate/Grand Order",
        "quote_verified": true
